{% extends "base.html" %}

{% block content %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css">
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

<style>
    :root {
        --claro-red: #E60000;
        --claro-red-dark: #B71C1C;
        --green: #2E7D32;
        --blue: #1565C0;
        --yellow: #F9A825;
        --soft-bg: #F5F6FA;
        --line: #E5E7EB;
        --shadow: 0 14px 35px rgba(15, 23, 42, 0.10);
        --radius: 18px;
    }

    html, body {
        background: var(--soft-bg) !important;
        overflow-x: hidden;
    }

    .ret-page {
        position: relative;
        z-index: 10;
        min-height: 100vh;
        padding: 18px 22px 32px;
        background:
            radial-gradient(circle at top left, rgba(230,0,0,0.10), transparent 32%),
            radial-gradient(circle at bottom right, rgba(21,101,192,0.08), transparent 36%),
            var(--soft-bg);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    .ret-hero {
        border-radius: 22px;
        padding: 18px 22px;
        margin-bottom: 16px;
        color: white;
        background: linear-gradient(120deg, #E60000 0%, #B71C1C 52%, #7F1111 100%);
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .ret-title-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ret-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: rgba(255,255,255,0.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        font-weight: 900;
        letter-spacing: -0.04em;
    }

    .ret-title {
        margin: 0;
        font-size: 1.55rem;
        font-weight: 900;
        letter-spacing: -0.03em;
    }

    .ret-subtitle {
        margin: 4px 0 0;
        opacity: 0.90;
        font-size: 0.92rem;
        font-weight: 600;
    }

    .ret-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .ret-btn {
        color: white !important;
        text-decoration: none !important;
        border: 1px solid rgba(255,255,255,0.32);
        background: rgba(255,255,255,0.13);
        padding: 9px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 0.88rem;
        transition: 0.18s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .ret-btn:hover {
        color: white !important;
        background: rgba(255,255,255,0.23);
        transform: translateY(-1px);
    }

    .filter-panel {
        background: rgba(255,255,255,0.94);
        border: 1px solid rgba(229,231,235,0.95);
        border-radius: var(--radius);
        box-shadow: 0 8px 22px rgba(15,23,42,0.07);
        padding: 14px;
        margin-bottom: 15px;
        backdrop-filter: blur(8px);
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(10, minmax(120px, 1fr));
        gap: 10px;
    }

    .filter-item label {
        display: block;
        font-size: 0.70rem;
        font-weight: 900;
        color: #374151;
        margin-bottom: 5px;
        letter-spacing: .04em;
    }

    .choices__inner {
        min-height: 38px;
        border-radius: 12px;
        border-color: #D1D5DB;
        background: white;
        font-size: 0.78rem;
    }

    .choices__list--multiple .choices__item {
        background: var(--claro-red);
        border-color: var(--claro-red);
        border-radius: 999px;
        font-size: 0.70rem;
        font-weight: 700;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 15px;
    }

    .kpi-card {
        background: white;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 16px 17px;
        box-shadow: 0 8px 24px rgba(15,23,42,0.07);
        position: relative;
        overflow: hidden;
    }

    .kpi-card::after {
        content: "";
        position: absolute;
        right: -35px;
        top: -35px;
        width: 95px;
        height: 95px;
        border-radius: 50%;
        background: rgba(230,0,0,0.07);
    }

    .kpi-label {
        font-size: 0.72rem;
        color: #6B7280;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .kpi-value {
        margin-top: 5px;
        font-size: 1.62rem;
        line-height: 1;
        font-weight: 950;
        color: #111827;
    }

    .kpi-foot {
        margin-top: 7px;
        color: #6B7280;
        font-size: 0.76rem;
        font-weight: 650;
    }

    .kpi-blue .kpi-value { color: #1565C0; }
    .kpi-green .kpi-value { color: #2E7D32; }
    .kpi-yellow .kpi-value { color: #B77900; }
    .kpi-red .kpi-value { color: #E60000; }

    .section-header {
        margin: 16px 0 10px;
        padding: 10px 14px;
        border-radius: 15px;
        color: white;
        font-weight: 950;
        letter-spacing: .03em;
        font-size: 0.84rem;
        text-transform: uppercase;
        background: linear-gradient(90deg, #E60000, #B71C1C);
        box-shadow: 0 7px 18px rgba(230,0,0,0.18);
    }

    .graph-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(260px, 1fr));
        gap: 13px;
    }

    .graph-card {
        background: white;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: 0 8px 24px rgba(15,23,42,0.07);
        padding: 10px;
        min-height: 390px;
    }

    .graph {
        width: 100%;
        height: 390px;
    }

    .loading-overlay {
        display: none;
        position: fixed;
        z-index: 9999;
        inset: 0;
        background: rgba(255,255,255,0.58);
        backdrop-filter: blur(2px);
        align-items: center;
        justify-content: center;
    }

    .loading-box {
        background: white;
        border-radius: 18px;
        box-shadow: var(--shadow);
        padding: 18px 22px;
        color: #111827;
        font-weight: 900;
        border: 1px solid var(--line);
    }

    .ret-note {
        margin-top: 14px;
        font-size: 0.76rem;
        color: #6B7280;
        text-align: right;
    }

    @media (max-width: 1400px) {
        .filter-grid {
            grid-template-columns: repeat(5, minmax(120px, 1fr));
        }
    }

    @media (max-width: 980px) {
        .ret-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .ret-actions {
            justify-content: flex-start;
        }

        .filter-grid {
            grid-template-columns: repeat(2, minmax(120px, 1fr));
        }

        .kpi-grid,
        .graph-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ret-page">
    <div class="ret-hero">
        <div class="ret-title-wrap">
            <div class="ret-icon">TOA</div>
            <div>
                <h1 class="ret-title">Retirada de Equipamentos</h1>
                <p class="ret-subtitle">Performance TOA — visão executiva por cidade, parceira, safra, status e habilidade operacional.</p>
            </div>
        </div>

        <div class="ret-actions">
            <a href="/adm/desconexao/" class="ret-btn">← Voltar para Desconexão</a>
            <a href="/" class="ret-btn">Página inicial</a>
        </div>
    </div>

    <div class="filter-panel">
        <div class="filter-grid">
            <div class="filter-item"><label>ANO</label><select id="ano" multiple></select></div>
            <div class="filter-item"><label>MÊS</label><select id="mes" multiple></select></div>
            <div class="filter-item"><label>DIA</label><select id="dia" multiple></select></div>
            <div class="filter-item"><label>UF</label><select id="uf" multiple></select></div>
            <div class="filter-item"><label>CIDADE</label><select id="cidade" multiple></select></div>
            <div class="filter-item"><label>PARCEIRA</label><select id="parceira" multiple></select></div>
            <div class="filter-item"><label>SAFRA</label><select id="safra" multiple></select></div>
            <div class="filter-item"><label>TIPO</label><select id="tipo" multiple></select></div>
            <div class="filter-item"><label>STATUS TOA</label><select id="status" multiple></select></div>
            <div class="filter-item"><label>PENDÊNCIA</label><select id="pend" multiple></select></div>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card kpi-blue">
            <div class="kpi-label">Total OS</div>
            <div id="kpi-total" class="kpi-value">0</div>
            <div class="kpi-foot">Universo com TOA</div>
        </div>

        <div class="kpi-card kpi-green">
            <div class="kpi-label">% Concluída</div>
            <div id="kpi-concluida" class="kpi-value">0%</div>
            <div id="kpi-qtd-concluida" class="kpi-foot">0 OS</div>
        </div>

        <div class="kpi-card kpi-yellow">
            <div class="kpi-label">% Em aberto</div>
            <div id="kpi-aberto" class="kpi-value">0%</div>
            <div id="kpi-qtd-aberto" class="kpi-foot">0 OS</div>
        </div>

        <div class="kpi-card kpi-red">
            <div class="kpi-label">% Falhas</div>
            <div id="kpi-falha" class="kpi-value">0%</div>
            <div id="kpi-qtd-falha" class="kpi-foot">0 OS</div>
        </div>
    </div>

    <div class="section-header">Performance por Cidade e Parceira</div>
    <div class="graph-grid">
        <div class="graph-card"><div id="g1" class="graph"></div></div>
        <div class="graph-card"><div id="g2" class="graph"></div></div>
    </div>

    <div class="section-header">Status da Atividade e Validação</div>
    <div class="graph-grid">
        <div class="graph-card"><div id="g3" class="graph"></div></div>
        <div class="graph-card"><div id="g4" class="graph"></div></div>
    </div>

    <div class="section-header">Análise por Safra e Habilidade TOA</div>
    <div class="graph-grid">
        <div class="graph-card"><div id="g5" class="graph"></div></div>
        <div class="graph-card"><div id="g6" class="graph"></div></div>
    </div>

    <div class="ret-note">Fonte: safra_enriquecida — registros com TEM_TOA = SIM.</div>
</div>

<div id="loading" class="loading-overlay">
    <div class="loading-box">Carregando Retirada...</div>
</div>

<script>
(function () {
    const API_URL = "/dash/retirada/api/dados";

    const FILTERS = [
        "ano", "mes", "dia", "uf", "cidade",
        "parceira", "safra", "tipo", "status", "pend"
    ];

    const PERF_ORDER = ["CONCLUIDA", "EM ABERTO", "FALHA"];

    const PERF_COLORS = {
        "CONCLUIDA": "#2E7D32",
        "EM ABERTO": "#F9A825",
        "FALHA": "#E60000"
    };

    const DONUT_COLORS = [
        "#2E7D32", "#F9A825", "#E60000",
        "#F57C00", "#1565C0", "#7B1FA2",
        "#9E9E9E", "#455A64"
    ];

    const choices = {};
    let updating = false;
    let controller = null;

    function showLoading(flag) {
        const el = document.getElementById("loading");
        if (el) {
            el.style.display = flag ? "flex" : "none";
        }
    }

    function initChoices() {
        FILTERS.forEach(function (id) {
            const el = document.getElementById(id);

            choices[id] = new Choices(el, {
                removeItemButton: true,
                shouldSort: false,
                searchEnabled: true,
                placeholder: true,
                placeholderValue: "Todos...",
                noResultsText: "Nenhum resultado",
                noChoicesText: "Sem opções",
                itemSelectText: "",
                loadingText: "Carregando..."
            });

            el.addEventListener("addItem", onFilterChange);
            el.addEventListener("removeItem", onFilterChange);
            el.addEventListener("change", onFilterChange);
        });
    }

    function onFilterChange() {
        if (updating) {
            return;
        }
        fetchData();
    }

    function selectedValues(id) {
        const inst = choices[id];

        if (!inst) {
            return [];
        }

        const val = inst.getValue(true);

        if (!val) {
            return [];
        }

        if (Array.isArray(val)) {
            return val.map(String);
        }

        return [String(val)];
    }

    function buildParams() {
        const params = new URLSearchParams();

        FILTERS.forEach(function (id) {
            selectedValues(id).forEach(function (v) {
                params.append(id, v);
            });
        });

        return params;
    }

    function updateChoices(opcoes) {
        if (!opcoes) {
            return;
        }

        updating = true;

        FILTERS.forEach(function (id) {
            const inst = choices[id];

            if (!inst) {
                return;
            }

            const selected = selectedValues(id);
            const opts = opcoes[id] || [];

            inst.clearStore();

            const data = opts.map(function (x) {
                return {
                    value: String(x.value),
                    label: String(x.label)
                };
            });

            inst.setChoices(data, "value", "label", true);

            const available = new Set(data.map(function (x) {
                return String(x.value);
            }));

            const keep = selected.filter(function (v) {
                return available.has(String(v));
            });

            if (keep.length > 0) {
                inst.setChoiceByValue(keep);
            }
        });

        updating = false;
    }

    function fmtOS(n) {
        if (n === undefined || n === null) {
            return "0 OS";
        }

        return Number(n).toLocaleString("pt-BR") + " OS";
    }

    function updateKpis(kpis) {
        kpis = kpis || {};

        document.getElementById("kpi-total").innerText = kpis.total || "0";
        document.getElementById("kpi-concluida").innerText = kpis.concluida || "0%";
        document.getElementById("kpi-aberto").innerText = kpis.aberto || "0%";
        document.getElementById("kpi-falha").innerText = kpis.falha || "0%";

        document.getElementById("kpi-qtd-concluida").innerText = fmtOS(kpis.qtd_concluida);
        document.getElementById("kpi-qtd-aberto").innerText = fmtOS(kpis.qtd_aberto);
        document.getElementById("kpi-qtd-falha").innerText = fmtOS(kpis.qtd_falha);
    }

    function baseLayout(title, height) {
        return {
            title: {
                text: title,
                x: 0.01,
                font: {
                    size: 15,
                    color: "#111827",
                    family: "Inter, Segoe UI, Arial"
                }
            },
            height: height || 380,
            margin: { l: 20, r: 18, t: 50, b: 38 },
            paper_bgcolor: "white",
            plot_bgcolor: "white",
            font: {
                family: "Inter, Segoe UI, Arial",
                size: 11,
                color: "#374151"
            },
            legend: {
                orientation: "h",
                y: -0.20,
                x: 0.5,
                xanchor: "center",
                font: { size: 10 }
            }
        };
    }

    function emptyChart(el, msg) {
        const layout = baseLayout(msg || "Sem dados", 380);

        layout.annotations = [{
            text: msg || "Sem dados",
            showarrow: false,
            x: 0.5,
            y: 0.5,
            xref: "paper",
            yref: "paper",
            font: {
                size: 16,
                color: "#9CA3AF"
            }
        }];

        Plotly.react(el, [], layout, {
            displayModeBar: false,
            responsive: true
        });
    }

    function stackedPercent(el, payload, title) {
        if (!payload || !payload.labels || payload.labels.length === 0) {
            emptyChart(el, "Sem dados");
            return;
        }

        const traces = PERF_ORDER.map(function (perf) {
            const x = payload.series[perf] || [];

            return {
                type: "bar",
                orientation: "h",
                name: perf,
                y: payload.labels,
                x: x,
                marker: { color: PERF_COLORS[perf] },
                text: x.map(function (v) {
                    return v > 0 ? Math.round(v) + "%" : "";
                }),
                textposition: "inside",
                insidetextanchor: "middle",
                hovertemplate: "%{y} - " + perf + ": %{x:.1f}%"
            };
        });

        const layout = baseLayout(title, 390);

        layout.barmode = "stack";
        layout.xaxis = {
            title: "%",
            range: [0, 100],
            ticksuffix: "%",
            gridcolor: "#EEF2F7"
        };
        layout.yaxis = {
            title: "",
            automargin: true
        };

        Plotly.react(el, traces, layout, {
            displayModeBar: false,
            responsive: true
        });
    }

    function stackedQtd(el, payload, title) {
        if (!payload || !payload.labels || payload.labels.length === 0) {
            emptyChart(el, "Sem dados");
            return;
        }

        const traces = PERF_ORDER.map(function (perf) {
            const x = payload.series[perf] || [];

            return {
                type: "bar",
                orientation: "h",
                name: perf,
                y: payload.labels,
                x: x,
                marker: { color: PERF_COLORS[perf] },
                text: x.map(function (v) {
                    return v > 0 ? String(v) : "";
                }),
                textposition: "inside",
                insidetextanchor: "middle",
                hovertemplate: "%{y} - " + perf + ": %{x}"
            };
        });

        const layout = baseLayout(title, 390);

        layout.barmode = "stack";
        layout.xaxis = {
            title: "Quantidade",
            gridcolor: "#EEF2F7"
        };
        layout.yaxis = {
            title: "",
            automargin: true
        };

        Plotly.react(el, traces, layout, {
            displayModeBar: false,
            responsive: true
        });
    }

    function donut(el, payload, title) {
        if (!payload || !payload.labels || payload.labels.length === 0) {
            emptyChart(el, "Sem dados");
            return;
        }

        const trace = {
            type: "pie",
            labels: payload.labels,
            values: payload.values,
            hole: 0.48,
            textinfo: "label+percent",
            textposition: "outside",
            marker: {
                colors: DONUT_COLORS
            },
            hovertemplate: "%{label} - Qtd: %{value} - %{percent}"
        };

        const layout = baseLayout(title, 390);

        layout.margin = { l: 20, r: 20, t: 50, b: 20 };
        layout.showlegend = true;
        layout.legend = {
            orientation: "h",
            y: -0.12,
            x: 0.5,
            xanchor: "center",
            font: { size: 10 }
        };

        Plotly.react(el, [trace], layout, {
            displayModeBar: false,
            responsive: true
        });
    }

    function renderCharts(charts) {
        charts = charts || {};

        stackedPercent(
            "g1",
            charts.g1_cidade_pct,
            "% Performance por Cidade"
        );

        stackedQtd(
            "g2",
            charts.g2_parceira_qtd,
            "Top 10 Parceiras — Volume + Performance"
        );

        donut(
            "g3",
            charts.g3_status,
            "Status da Atividade TOA"
        );

        donut(
            "g4",
            charts.g4_validacao,
            "Validação da Baixa TOA"
        );

        stackedPercent(
            "g5",
            charts.g5_safra_tipo_pct,
            "% Performance por Safra x Tipo Desconexão"
        );

        stackedQtd(
            "g6",
            charts.g6_habilidade_qtd,
            "Top 10 Habilidades TOA — Volume + Performance"
        );
    }

    async function fetchData() {
        if (controller) {
            controller.abort();
        }

        controller = new AbortController();

        const params = buildParams();
        const url = API_URL + "?" + params.toString();

        showLoading(true);

        try {
            const resp = await fetch(url, {
                signal: controller.signal,
                headers: {
                    "Accept": "application/json"
                }
            });

            const data = await resp.json();

            updateChoices(data.opcoes || {});
            updateKpis(data.kpis || {});
            renderCharts(data.charts || {});

        } catch (err) {
            if (err.name !== "AbortError") {
                console.error("[RETIRADA] Erro ao carregar dados:", err);
            }
        } finally {
            showLoading(false);
        }
    }

    window.addEventListener("resize", function () {
        ["g1", "g2", "g3", "g4", "g5", "g6"].forEach(function (id) {
            const el = document.getElementById(id);

            if (el) {
                Plotly.Plots.resize(el);
            }
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        initChoices();
        fetchData();
    });
})();
</script>

{% endblock %}
