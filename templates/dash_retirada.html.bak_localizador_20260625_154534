    .ret-btn:hover {
        color: white !important;
        background: rgba(255,255,255,0.23);
        transform: translateY(-1px);
    }

    .filter-panel {
        background: rgba(255,255,255,0.94);
        border: 1px solid rgba(229,231,235,0.95);
        border-radius: var(--radius);
        box-shadow: 0 8px 22px rgba(15,23,42,0.07);
        padding: 14px;
        margin-bottom: 15px;
        backdrop-filter: blur(8px);
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(10, minmax(120px, 1fr));
        gap: 10px;
    }

    .filter-item label {
        display: block;
        font-size: 0.70rem;
        font-weight: 900;
        color: #374151;
        margin-bottom: 5px;
        letter-spacing: .04em;
    }

    .choices__inner {
        min-height: 38px;
        border-radius: 12px;
        border-color: #D1D5DB;
        background: white;
        font-size: 0.78rem;
    }

    .choices__list--multiple .choices__item {
        background: var(--claro-red);
        border-color: var(--claro-red);
        border-radius: 999px;
        font-size: 0.70rem;
        font-weight: 700;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 15px;
    }

    .kpi-card {
        background: white;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 16px 17px;
        box-shadow: 0 8px 24px rgba(15,23,42,0.07);
        position: relative;
        overflow: hidden;
    }

    .kpi-card::after {
        content: "";
        position: absolute;
        right: -35px;
        top: -35px;
        width: 95px;
        height: 95px;
        border-radius: 50%;
        background: rgba(230,0,0,0.07);
    }

    .kpi-label {
        font-size: 0.72rem;
        color: #6B7280;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .kpi-value {
        margin-top: 5px;
        font-size: 1.62rem;
        line-height: 1;
        font-weight: 950;
        color: #111827;
    }

    .kpi-foot {
        margin-top: 7px;
        color: #6B7280;
        font-size: 0.76rem;
        font-weight: 650;
    }

    .kpi-blue .kpi-value { color: #1565C0; }
    .kpi-green .kpi-value { color: #2E7D32; }
    .kpi-yellow .kpi-value { color: #B77900; }
    .kpi-red .kpi-value { color: #E60000; }

    .section-header {
        margin: 16px 0 10px;
        padding: 10px 14px;
        border-radius: 15px;
        color: white;
        font-weight: 950;
        letter-spacing: .03em;
        font-size: 0.84rem;
        text-transform: uppercase;
        background: linear-gradient(90deg, #E60000, #B71C1C);
        box-shadow: 0 7px 18px rgba(230,0,0,0.18);
    }

    .graph-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(260px, 1fr));
        gap: 13px;
    }

    .graph-card {
        background: white;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: 0 8px 24px rgba(15,23,42,0.07);
        padding: 10px;
        min-height: 390px;
    }

    .graph {
        width: 100%;
        height: 390px;
    }

    .loading-overlay {
        display: none;
        position: fixed;
        z-index: 9999;
        inset: 0;
        background: rgba(255,255,255,0.58);
        backdrop-filter: blur(2px);
        align-items: center;
        justify-content: center;
    }

    .loading-box {
        background: white;
        border-radius: 18px;
        box-shadow: var(--shadow);
        padding: 18px 22px;
        color: #111827;
        font-weight: 900;
        border: 1px solid var(--line);
    }

    .ret-note {
        margin-top: 14px;
        font-size: 0.76rem;
        color: #6B7280;
        text-align: right;
    }

    @media (max-width: 1400px) {
        .filter-grid {
            grid-template-columns: repeat(5, minmax(120px, 1fr));
        }
    }

    @media (max-width: 980px) {
        .ret-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .ret-actions {
            justify-content: flex-start;
        }

        .filter-grid {
            grid-template-columns: repeat(2, minmax(120px, 1fr));
        }

        .kpi-grid,
        .graph-grid {
            grid-template-columns: 1fr;
        }
    }

/* ============================================================
   FIX FASE 2B — RETIRADA — FILTROS SEM SOBREPOSIÇÃO
   ============================================================ */

/* O painel precisa poder crescer quando um dropdown abrir */
.filter-panel {
    position: relative !important;
    overflow: visible !important;
    z-index: 50 !important;
    padding: 18px 20px 20px !important;
    margin-bottom: 24px !important;
}

/* Layout igual aos dashboards já estabilizados: 5 filtros por linha */
.filter-grid {
    display: grid !important;
    grid-template-columns: repeat(5, minmax(170px, 1fr)) !important;
    gap: 16px 18px !important;
    align-items: start !important;
    overflow: visible !important;
}

/* Cada filtro fica independente e com altura natural */
.filter-item {
    position: relative !important;
    overflow: visible !important;
    min-width: 0 !important;
    z-index: auto !important;
}

/* Rótulo sempre acima do campo, sem ficar atrás de dropdown */
.filter-item label {
    position: relative !important;
    z-index: 2 !important;
    display: block !important;
    margin-bottom: 7px !important;
    font-size: 0.74rem !important;
    font-weight: 900 !important;
    color: #374151 !important;
    letter-spacing: .035em !important;
    line-height: 1.15 !important;
}

/* Container do Choices com altura natural */
.choices {
    position: relative !important;
    overflow: visible !important;
    margin-bottom: 0 !important;
    z-index: auto !important;
}

/* Campo principal do filtro */
.choices__inner {
    min-height: 44px !important;
    height: auto !important;
    max-height: 86px !important;
    overflow-y: auto !important;
    border-radius: 13px !important;
    border: 1px solid #D1D5DB !important;
    background: #FFFFFF !important;
    box-shadow: none !important;
    padding: 7px 9px !important;
}

/* Seleções múltiplas dentro do campo */
.choices__list--multiple {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 4px !important;
}

/* Chips vermelhos dos itens selecionados */
.choices__list--multiple .choices__item {
    margin: 2px 2px 2px 0 !important;
    padding: 5px 9px !important;
    background: #E60000 !important;
    border: 1px solid #E60000 !important;
    color: #FFFFFF !important;
    border-radius: 999px !important;
    font-size: 0.72rem !important;
    font-weight: 800 !important;
    line-height: 1.1 !important;
}

/* Input de busca */
.choices__input {
    background: transparent !important;
    min-width: 90px !important;
    font-size: 0.84rem !important;
}

/* Placeholder */
.choices__placeholder {
    opacity: 0.72 !important;
}

/* 
   PONTO PRINCIPAL DA CORREÇÃO:
   Quando o dropdown abrir, ele NÃO deve ser absoluto.
   Ele entra no fluxo e aumenta a altura do painel.
*/
.choices.is-open .choices__list--dropdown,
.choices.is-open .choices__list[aria-expanded],
.choices__list--dropdown.is-active,
.choices__list[aria-expanded].is-active {
    position: static !important;
    display: block !important;
    width: 100% !important;
    min-width: 100% !important;
    max-height: 240px !important;
    overflow-y: auto !important;
    margin-top: 7px !important;
    border-radius: 13px !important;
    border: 1px solid #D1D5DB !important;
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.18) !important;
    background: #FFFFFF !important;
    z-index: auto !important;
}

/* Remove qualquer posicionamento absoluto herdado de correções anteriores */
.choices__list--dropdown,
.choices__list[aria-expanded] {
    left: auto !important;
    right: auto !important;
    top: auto !important;
}

/* Itens da lista aberta */
.choices__list--dropdown .choices__item,
.choices__list[aria-expanded] .choices__item {
    padding: 10px 13px !important;
    font-size: 0.88rem !important;
    color: #111827 !important;
    line-height: 1.2 !important;
}

/* Hover do item */
.choices__list--dropdown .choices__item--selectable.is-highlighted,
.choices__list[aria-expanded] .choices__item--selectable.is-highlighted {
    background: #FEE2E2 !important;
    color: #991B1B !important;
}

/* Quando qualquer Choices estiver aberto, o painel fica acima dos KPIs */
.filter-panel:has(.choices.is-open) {
    z-index: 500 !important;
}

/* KPIs e gráficos ficam abaixo do painel, sem disputar camada */
.kpi-grid,
.section-header,
.graph-grid,
.graph-card {
    position: relative !important;
    z-index: 1 !important;
}

/* Ajuste fino para notebook padrão */
@media (max-width: 1500px) {
    .filter-grid {
        grid-template-columns: repeat(5, minmax(145px, 1fr)) !important;
        gap: 14px 16px !important;
    }
}

/* Tela média */
@media (max-width: 1100px) {
    .filter-grid {
        grid-template-columns: repeat(3, minmax(150px, 1fr)) !important;
    }
}

/* Mobile */
@media (max-width: 700px) {
    .filter-grid {
        grid-template-columns: 1fr !important;
    }
}


/* ============================================================
   FIX FASE 2B — RETIRADA — CAMPOS COM CHIPS COMPACTOS
   ============================================================ */

/* Reduz o espaçamento geral do painel sem perder leitura */
.filter-panel {
    padding: 14px 18px 16px !important;
    margin-bottom: 18px !important;
}

.filter-grid {
    gap: 12px 16px !important;
    align-items: start !important;
}

.filter-item label {
    margin-bottom: 5px !important;
    font-size: 0.72rem !important;
    line-height: 1 !important;
}

/* Campo principal mais baixo e estável */
.choices {
    min-height: 38px !important;
    margin-bottom: 0 !important;
}

.choices__inner {
    min-height: 38px !important;
    height: 38px !important;
    max-height: 38px !important;
    padding: 4px 8px !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: center !important;
    border-radius: 12px !important;
}

/* A lista interna vira linha única com rolagem horizontal, sem aumentar altura */
.choices__list--multiple {
    display: flex !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    gap: 4px !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    max-width: 100% !important;
    scrollbar-width: thin !important;
    padding-bottom: 0 !important;
}

.choices__list--multiple::-webkit-scrollbar {
    height: 4px !important;
}

.choices__list--multiple::-webkit-scrollbar-thumb {
    background: rgba(230,0,0,0.35) !important;
    border-radius: 999px !important;
}

/* Chips menores, mantendo identidade Claro */
.choices__list--multiple .choices__item {
    flex: 0 0 auto !important;
    margin: 0 2px 0 0 !important;
    padding: 4px 8px !important;
    max-width: 118px !important;
    overflow: hidden !important;
    white-space: nowrap !important;
    text-overflow: ellipsis !important;
    background: #E60000 !important;
    border: 1px solid #E60000 !important;
    color: #FFFFFF !important;
    border-radius: 999px !important;
