}

/* Botão X do chip mais discreto */
.choices__list--multiple .choices__item .choices__button {
    margin-left: 6px !important;
    padding-left: 6px !important;
    border-left: 1px solid rgba(255,255,255,0.45) !important;
    width: 10px !important;
    opacity: 0.95 !important;
}

/* Placeholder/input alinhados na mesma altura */
.choices__input {
    min-width: 70px !important;
    height: 24px !important;
    margin: 0 !important;
    padding: 0 2px !important;
    font-size: 0.80rem !important;
    line-height: 24px !important;
    background: transparent !important;
}

.choices__placeholder {
    opacity: 0.70 !important;
}

/* Dropdown continua abrindo dentro do fluxo, mas mais compacto */
.choices.is-open .choices__list--dropdown,
.choices.is-open .choices__list[aria-expanded],
.choices__list--dropdown.is-active,
.choices__list[aria-expanded].is-active {
    position: static !important;
    display: block !important;
    width: 100% !important;
    min-width: 100% !important;
    max-height: 210px !important;
    overflow-y: auto !important;
    margin-top: 6px !important;
    border-radius: 12px !important;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.16) !important;
}

.choices__list--dropdown .choices__item,
.choices__list[aria-expanded] .choices__item {
    padding: 8px 11px !important;
    font-size: 0.84rem !important;
    line-height: 1.15 !important;
}

/* Evita que chips longos alarguem a coluna */
.filter-item,
.choices,
.choices__inner {
    min-width: 0 !important;
    max-width: 100% !important;
}

/* KPIs um pouco mais próximos após compactação */
.kpi-grid {
    margin-top: 2px !important;
}

</style>

