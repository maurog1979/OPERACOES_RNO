        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .ret-title-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ret-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: rgba(255,255,255,0.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        font-weight: 900;
        letter-spacing: -0.04em;
    }

    .ret-title {
        margin: 0;
        font-size: 1.55rem;
        font-weight: 900;
        letter-spacing: -0.03em;
    }

    .ret-subtitle {
        margin: 4px 0 0;
        opacity: 0.90;
        font-size: 0.92rem;
        font-weight: 600;
    }

    .ret-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .ret-btn {
        color: white !important;
