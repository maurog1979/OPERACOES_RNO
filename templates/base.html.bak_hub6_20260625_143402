<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}{{ APP_NAME }}
<style>
/* === HUB RETIRADA ATIVA V3 GLOBAL === */
.hub-retirada-ativo-v3 {
    cursor: pointer !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    filter: none !important;
}

.hub-retirada-ativo-v3 * {
    pointer-events: auto !important;
}

.hub-retirada-ativo-v3 .em-breve,
.hub-retirada-ativo-v3 .coming-soon,
.hub-retirada-ativo-v3 .soon,
.hub-retirada-ativo-v3 .disabled,
.hub-retirada-ativo-v3 .inativo {
    opacity: 1 !important;
    filter: none !important;
}

.hub-retirada-badge-v3 {
    background: linear-gradient(135deg, #E60000, #B71C1C) !important;
    color: #FFFFFF !important;
    border-radius: 999px !important;
    font-weight: 900 !important;
    opacity: 1 !important;
}
/* === FIM HUB RETIRADA ATIVA V3 GLOBAL === */
</style>

<script>
/* === HUB RETIRADA ATIVA V3 GLOBAL === */
(function () {
    const ROTA_RETIRADA = "/dash/retirada/";

    function norm(txt) {
        return String(txt || "")
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "");
    }

    function textoContemRetirada(el) {
        return norm(el && el.textContent).includes("retirada de equipamentos");
    }

    function trocarTextosNoElemento(root) {
        if (!root) {
            return;
        }

        const walker = document.createTreeWalker(
            root,
            NodeFilter.SHOW_TEXT,
            null
        );

        const nodes = [];

        while (walker.nextNode()) {
            nodes.push(walker.currentNode);
        }

        nodes.forEach(function (node) {
            let t = node.nodeValue || "";
            const original = t;

            t = t.replace(/ACESSAR/g, "ACESSAR");
            t = t.replace(/ACESSAR/g, "ACESSAR");
            t = t.replace(/ACESSAR/g, "ACESSAR");

            t = t.replace(/Disponível/g, "Disponível");
            t = t.replace(/DISPONÍVEL/g, "Disponível");
            t = t.replace(/Disponível/g, "Disponível");

            if (t !== original) {
                node.nodeValue = t;
            }
        });
    }

    function removerBloqueios(el) {
        if (!el) {
            return;
        }

        const classes = [
            "disabled",
            "is-disabled",
            "card-disabled",
            "card-inativo",
            "inativo",
            "soon",
            "coming-soon",
            "em-breve",
            "bloqueado"
        ];

        classes.forEach(function (c) {
            el.classList.remove(c);
        });

        el.removeAttribute("disabled");
        el.removeAttribute("aria-disabled");

        if (el.getAttribute("tabindex") === "-1") {
            el.removeAttribute("tabindex");
        }

        el.style.pointerEvents = "auto";
        el.style.cursor = "pointer";
        el.style.opacity = "1";
        el.style.filter = "none";

        el.classList.add("hub-retirada-ativo-v3");
    }

    function procurarMenorContainerRetirada() {
        const todos = Array.from(document.querySelectorAll("a, article, section, div, li"));

        const candidatos = todos
            .filter(textoContemRetirada)
            .map(function (el) {
                return {
                    el: el,
                    len: String(el.textContent || "").trim().length
                };
            })
            .filter(function (x) {
                return x.len >= 20 && x.len <= 1200;
            });

        if (!candidatos.length) {
            return null;
        }

        candidatos.sort(function (a, b) {
            return a.len - b.len;
        });

        let card = candidatos[0].el;

        const cardMaisProvavel = card.closest(
            "a, article, li, .card, .hub-card, .dash-card, .dashboard-card, .report-card, .menu-card, .portal-card"
        );

        if (cardMaisProvavel && textoContemRetirada(cardMaisProvavel)) {
            card = cardMaisProvavel;
        }

        return card;
    }

    function aplicarBadgeVisual(card) {
        if (!card) {
            return;
        }

        const elementos = Array.from(card.querySelectorAll("*"));

        elementos.forEach(function (el) {
            const txt = norm(el.textContent);

            if (txt === "acessar" || txt.includes("acessar")) {
                el.classList.add("hub-retirada-badge-v3");
            }
        });
    }

    function ativarCardRetirada() {
        const card = procurarMenorContainerRetirada();

        if (!card) {
            return false;
        }

        trocarTextosNoElemento(card);
        removerBloqueios(card);
        aplicarBadgeVisual(card);

        const links = Array.from(card.querySelectorAll("a"));

        if (card.tagName && card.tagName.toLowerCase() === "a") {
            card.setAttribute("href", ROTA_RETIRADA);
            card.removeAttribute("target");
        }

        links.forEach(function (a) {
            a.setAttribute("href", ROTA_RETIRADA);
            a.removeAttribute("target");
            removerBloqueios(a);
        });

        if (!(card.tagName && card.tagName.toLowerCase() === "a")) {
            card.setAttribute("role", "link");
            card.setAttribute("tabindex", "0");
            card.setAttribute("data-href", ROTA_RETIRADA);

            if (!card.dataset.retiradaClickV3) {
                card.dataset.retiradaClickV3 = "1";

                card.addEventListener("click", function (ev) {
                    const alvo = ev.target;

                    if (alvo && alvo.closest && alvo.closest("a")) {
                        return;
                    }

                    window.location.href = ROTA_RETIRADA;
                });

                card.addEventListener("keydown", function (ev) {
                    if (ev.key === "Enter" || ev.key === " ") {
                        ev.preventDefault();
                        window.location.href = ROTA_RETIRADA;
                    }
                });
            }
        }

        console.log("[HUB] Card Retirada ativado V3:", ROTA_RETIRADA);
        return true;
    }

    function executarComTentativas() {
        ativarCardRetirada();

        setTimeout(ativarCardRetirada, 200);
        setTimeout(ativarCardRetirada, 700);
        setTimeout(ativarCardRetirada, 1500);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", executarComTentativas);
    } else {
        executarComTentativas();
    }

    const obs = new MutationObserver(function () {
        ativarCardRetirada();
    });

    obs.observe(document.documentElement, {
        childList: true,
        subtree: true
    });
})();
/* === FIM HUB RETIRADA ATIVA V3 GLOBAL === */
</script>



