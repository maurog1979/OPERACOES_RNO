                };
            })
            .filter(function (x) {
                return x.len >= 20 && x.len <= 1300;
            });

        if (!candidatos.length) {
            return;
        }

        candidatos.sort(function (a, b) {
            return a.len - b.len;
        });

        let card = candidatos[0].el;

        const ancestral = card.closest(
            "a, article, li, .card, .hub-card, .dash-card, .dashboard-card, .report-card, .menu-card, .portal-card"
        );

        if (ancestral && norm(ancestral.textContent).includes("retirada de equipamentos")) {
            card = ancestral;
        }

        trocarTextos(card);

        card.classList.remove("disabled", "is-disabled", "card-disabled", "card-inativo", "inativo", "soon", "coming-soon", "em-breve", "bloqueado");
        card.classList.add("card-retirada-origem-real-ativo");
        card.removeAttribute("disabled");
        card.removeAttribute("aria-disabled");
        card.style.pointerEvents = "auto";
        card.style.cursor = "pointer";
        card.style.opacity = "1";
        card.style.filter = "none";

        if (card.tagName && card.tagName.toLowerCase() === "a") {
            card.setAttribute("href", ROTA);
        } else {
            card.setAttribute("role", "link");
            card.setAttribute("tabindex", "0");
            card.onclick = function (ev) {
                if (ev.target && ev.target.closest && ev.target.closest("a")) {
                    return;
                }
                window.location.href = ROTA;
            };
        }

        card.querySelectorAll("a").forEach(function (a) {
            a.setAttribute("href", ROTA);
            a.removeAttribute("target");
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", ativar);
    } else {
        ativar();
    }

    setTimeout(ativar, 250);
    setTimeout(ativar, 800);
    setTimeout(ativar, 1600);
})();
/* === FIM PATCH DIRETO CARD RETIRADA ORIGEM REAL === */
</script>



