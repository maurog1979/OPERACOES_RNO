{% extends "base.html" %}

{% block title %}ADM | Desconexão
<style>
/* === ATIVACAO SEGURA CARD RETIRADA V2 === */
.card-retirada-ativo-v2 {
    cursor: pointer !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    filter: none !important;
}

.card-retirada-ativo-v2 * {
    pointer-events: auto !important;
}
/* === FIM ATIVACAO SEGURA CARD RETIRADA V2 === */
</style>

<script>
/* === ATIVACAO SEGURA CARD RETIRADA V2 === */
(function () {
    const ROTA_RETIRADA = "/dash/retirada/";

    function norm(txt) {
        return String(txt || "")
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "");
    }

    function trocarTextos(root) {
        const walker = document.createTreeWalker(
            root,
            NodeFilter.SHOW_TEXT,
            null
        );

        const nodes = [];

        while (walker.nextNode()) {
            nodes.push(walker.currentNode);
        }

        nodes.forEach(function (node) {
            let t = node.nodeValue;

            if (!t) {
                return;
            }

            t = t.replace(/EM BREVE/g, "Acessar");
            t = t.replace(/Em breve/g, "Acessar");
            t = t.replace(/em breve/g, "Acessar");
            t = t.replace(/Em desenvolvimento/g, "Disponível");
            t = t.replace(/EM DESENVOLVIMENTO/g, "Disponível");
            t = t.replace(/em desenvolvimento/g, "Disponível");

            node.nodeValue = t;
        });
    }

    function removerBloqueios(el) {
        if (!el) {
            return;
        }

        const classesRemover = [
            "disabled",
            "is-disabled",
            "card-disabled",
            "card-inativo",
            "inativo",
            "soon",
            "coming-soon",
            "em-breve",
            "bloqueado"
        ];

        classesRemover.forEach(function (cls) {
            el.classList.remove(cls);
        });

        el.removeAttribute("disabled");
        el.removeAttribute("aria-disabled");
        el.removeAttribute("tabindex");

        el.style.pointerEvents = "auto";
        el.style.cursor = "pointer";
        el.style.opacity = "1";
        el.style.filter = "none";

        el.classList.add("card-retirada-ativo-v2");
    }

    function escolherCardRetirada() {
        const candidatos = Array.from(
            document.querySelectorAll("a, article, section, div")
        ).filter(function (el) {
            const texto = norm(el.textContent);
            return texto.includes("retirada de equipamentos");
        }).filter(function (el) {
            const tamanho = String(el.textContent || "").trim().length;
            return tamanho >= 20 && tamanho <= 1800;
        });

        if (!candidatos.length) {
            return null;
        }

        candidatos.sort(function (a, b) {
            const ta = String(a.textContent || "").trim().length;
            const tb = String(b.textContent || "").trim().length;
            return ta - tb;
        });

        let card = candidatos[0];

        const ancestral = card.closest(
            "a, article, .card, .hub-card, .dash-card, .dashboard-card, .report-card, .menu-card"
        );

        if (ancestral) {
            card = ancestral;
        }

        return card;
    }

    function ativarCard() {
        const card = escolherCardRetirada();

        if (!card) {
            console.warn("[HUB] Card Retirada não encontrado para ativação.");
            return;
        }

        trocarTextos(card);
        removerBloqueios(card);

        if (card.tagName && card.tagName.toLowerCase() === "a") {
            card.setAttribute("href", ROTA_RETIRADA);
            card.removeAttribute("target");
        } else {
            card.setAttribute("role", "link");
            card.setAttribute("tabindex", "0");
            card.setAttribute("data-href", ROTA_RETIRADA);

            card.addEventListener("click", function (ev) {
                const alvo = ev.target;

                if (alvo && alvo.closest && alvo.closest("a")) {
                    return;
                }

                window.location.href = ROTA_RETIRADA;
            });

            card.addEventListener("keydown", function (ev) {
                if (ev.key === "Enter" || ev.key === " ") {
                    ev.preventDefault();
                    window.location.href = ROTA_RETIRADA;
                }
            });
        }

        const linksInternos = card.querySelectorAll("a");

        linksInternos.forEach(function (a) {
            a.setAttribute("href", ROTA_RETIRADA);
            a.removeAttribute("target");
            removerBloqueios(a);
        });

        console.log("[HUB] Card Retirada ativado:", ROTA_RETIRADA);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", ativarCard);
    } else {
        ativarCard();
    }
})();
/* === FIM ATIVACAO SEGURA CARD RETIRADA V2 === */
</script>


{% endblock %}

{% block content %}
<style>
  :root {
    --claro-red: #E60000;
    --claro-red-dark: #B71C1C;
    --card: #FFFFFF;
    --text: #202234;
    --muted: #6C757D;
    --soon: #F4A261;
  }

  .hub-wrap {
    width: min(1780px, calc(100vw - 56px));
    margin: 0 auto;
    padding: 34px 0 54px;
  }

  .hub-breadcrumb {
    color: #8B8EA1;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .hub-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .hub-titlebox {
    border-left: 7px solid var(--claro-red);
    padding-left: 18px;
  }

  .hub-eyebrow {
    color: var(--claro-red);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .hub-title {
    margin: 0;
    color: var(--text);
    font-size: clamp(30px, 3vw, 46px);
    line-height: 1.03;
    font-weight: 950;
  }

  .hub-subtitle {
    margin: 12px 0 0;
    max-width: 760px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.45;
    font-weight: 600;
  }

  .hub-pill {
    flex: 0 0 auto;
    padding: 12px 18px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(0,0,0,.06);
    color: var(--muted);
    font-size: 13px;
    font-weight: 900;
    box-shadow: 0 16px 36px rgba(19, 24, 44, .06);
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(250px, 1fr));
    gap: 28px;
  }

  .dash-card,
  .dash-card-soon {
    position: relative;
    min-height: 230px;
    border-radius: 28px;
    background: var(--card);
    border: 1px solid rgba(0,0,0,.055);
    box-shadow: 0 18px 48px rgba(25, 30, 55, .055);
    padding: 31px 31px 26px;
    overflow: hidden;
    text-decoration: none !important;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  a.dash-card {
    cursor: pointer !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    filter: none !important;
  }

  a.dash-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 70px rgba(25, 30, 55, .105);
    border-color: rgba(230, 0, 0, .18);
  }

  a.dash-card:focus-visible {
    outline: 4px solid rgba(230,0,0,.18);
    outline-offset: 4px;
  }

  .dash-card-soon {
    opacity: .62;
    cursor: not-allowed;
    pointer-events: none;
    filter: grayscale(.08);
  }

  .card-icon {
    width: 74px;
    height: 74px;
    border-radius: 19px;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 31px;
    box-shadow: 0 18px 36px rgba(230, 0, 0, .18);
    margin-bottom: 20px;
  }

  .ic-red { background: linear-gradient(135deg, #E60000, #B71C1C); }
  .ic-blue { background: linear-gradient(135deg, #90CAF9, #1976D2); }
  .ic-orange { background: linear-gradient(135deg, #FFCC80, #F57C00); }
  .ic-purple { background: linear-gradient(135deg, #9C27B0, #5E35B1); }
  .ic-green { background: linear-gradient(135deg, #9BE7B0, #2E7D32); }
  .ic-pink { background: linear-gradient(135deg, #F06292, #C2185B); }

  .card-title {
    margin: 0 0 8px;
    color: var(--text);
    font-size: 24px;
    font-weight: 950;
    letter-spacing: -.03em;
  }

  .card-desc {
    margin: 0;
    color: #82889A;
    font-size: 16px;
    line-height: 1.45;
    font-weight: 650;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 24px;
  }

  .card-status {
    color: #6C757D;
    font-size: 14px;
    font-weight: 900;
  }

  .card-arrow {
    color: var(--claro-red);
    font-size: 30px;
    line-height: 1;
    font-weight: 950;
    transform: translateX(0);
    opacity: 1;
    transition: transform .18s ease;
  }

  a.dash-card:hover .card-arrow {
    transform: translateX(5px);
  }

  .soon-badge {
    padding: 8px 16px;
    border-radius: 999px;
    background: #F4A261;
    color: #fff;
    font-size: 13px;
    font-weight: 950;
    text-transform: uppercase;
  }

  @media (max-width: 1280px) { .hub-grid { grid-template-columns: repeat(3, minmax(250px, 1fr)); } }
  @media (max-width: 980px) { .hub-grid { grid-template-columns: repeat(2, minmax(250px, 1fr)); } .hub-hero { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 620px) { .hub-wrap { width: min(100% - 28px, 1780px); padding-top: 24px; } .hub-grid { grid-template-columns: 1fr; gap: 18px; } .dash-card, .dash-card-soon { min-height: 210px; padding: 26px; border-radius: 23px; } }
</style>

<div class="hub-wrap">
  <div class="hub-breadcrumb">ADM / DESCONEXÃO</div>

  <section class="hub-hero">
    <div class="hub-titlebox">
      <div class="hub-eyebrow">Portal Operações RNO</div>
      <h1 class="hub-title">Dashboards de Desconexão</h1>
      <p class="hub-subtitle">
        Relatórios executivos e operacionais para acompanhamento da safra, backlog,
