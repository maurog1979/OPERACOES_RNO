<!-- FIX_HUB_SEGURO_CSS: garante cards ativos/clicáveis no Hub Desconexão -->
<style>
  a[href="/dash/backlog/"],
  a[href="/dash/quebra/"],
  .fix-hub-card-active {
    opacity: 1 !important;
    pointer-events: auto !important;
    cursor: pointer !important;
    filter: none !important;
    text-decoration: none !important;
  }

  a[href="/dash/backlog/"] *,
  a[href="/dash/quebra/"] *,
  .fix-hub-card-active * {
    pointer-events: auto;
  }

  a[href="/dash/backlog/"] .card-arrow,
  a[href="/dash/quebra/"] .card-arrow,
  a[href="/dash/backlog/"] .arrow,
  a[href="/dash/quebra/"] .arrow,
  .fix-hub-card-active .card-arrow,
  .fix-hub-card-active .arrow {
    opacity: 1 !important;
    transform: translateX(0) !important;
    color: #E60000 !important;
  }

  .fix-hub-card-active:hover {
    transform: translateY(-2px);
  }

  .fix-hub-card-soon {
    opacity: .58 !important;
    pointer-events: none !important;
    cursor: not-allowed !important;
    filter: grayscale(.15);
  }
</style>

