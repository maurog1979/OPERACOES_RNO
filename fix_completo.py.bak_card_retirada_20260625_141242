from pathlib import Path
from datetime import datetime
import shutil
import re


ROOT = Path(__file__).resolve().parent
ROTA = "/dash/retirada/"
RELATORIO = ROOT / "diagnostico_card_retirada.txt"

EXTENSOES = {
    ".html",
    ".htm",
    ".py",
    ".js",
    ".json",
    ".css",
    ".txt",
}

IGNORAR_PARTES = [
    "\\.git\\",
    "/.git/",
    "\\__pycache__\\",
    "/__pycache__/",
    "\\venv\\",
    "/venv/",
    "\\env\\",
    "/env/",
    "\\node_modules\\",
    "/node_modules/",
    "\\backups\\",
    "/backups/",
]


def agora():
    return datetime.now().strftime("%Y%m%d_%H%M%S")


def normalizar(txt: str) -> str:
    mapa = {
        "ç": "c", "Ç": "C",
        "ã": "a", "Ã": "A",
        "á": "a", "Á": "A",
        "à": "a", "À": "A",
        "â": "a", "Â": "A",
        "é": "e", "É": "E",
        "ê": "e", "Ê": "E",
        "í": "i", "Í": "I",
        "ó": "o", "Ó": "O",
        "ô": "o", "Ô": "O",
        "õ": "o", "Õ": "O",
        "ú": "u", "Ú": "U",
    }

    for a, b in mapa.items():
        txt = txt.replace(a, b)

    return txt.lower()


def deve_ignorar(path: Path) -> bool:
    s = str(path)

    for parte in IGNORAR_PARTES:
        if parte in s:
            return True

    if path.suffix.lower() not in EXTENSOES:
        return True

    # Evita alterar backups antigos.
    nome = path.name.lower()

    if ".bak" in nome or "backup" in nome:
        return True

    return False


def read_text_safe(path: Path):
    try:
        return path.read_text(encoding="utf-8"), "utf-8"
    except UnicodeDecodeError:
        return path.read_text(encoding="latin-1"), "latin-1"


def write_text_safe(path: Path, txt: str, encoding: str):
    path.write_text(txt, encoding=encoding)


def backup_file(path: Path):
    backup = path.with_suffix(path.suffix + f".bak_card_retirada_{agora()}")
    shutil.copy2(path, backup)
    return backup


def is_placeholder_url(valor: str) -> bool:
    v = (valor or "").strip().lower()

    return v in {
        "",
        "#",
        "/#",
        "javascript:void(0)",
        "javascript:void(0);",
        "javascript:;",
        "none",
        "null",
        "false",
        "em_breve",
        "em-breve",
        "coming-soon",
        "soon",
    }


def remover_classes_bloqueio(segmento: str) -> str:
    bloqueios = {
        "disabled",
        "is-disabled",
        "card-disabled",
        "card-inativo",
        "inativo",
        "soon",
        "coming-soon",
        "em-breve",
        "bloqueado",
        "opacity-50",
        "opacity-60",
        "pointer-events-none",
        "cursor-not-allowed",
    }

    def repl_class(m):
        quote = m.group(1)
        classes = m.group(2)

        novas = []

        for c in classes.split():
            if c.lower() not in bloqueios:
                novas.append(c)

        return f'class={quote}{" ".join(novas)}{quote}'

    return re.sub(
        r'class\s*=\s*(["\'])(.*?)\1',
        repl_class,
        segmento,
        flags=re.IGNORECASE | re.DOTALL,
    )


def corrigir_textos(segmento: str) -> str:
    s = segmento

    substituicoes = [
        ("Em desenvolvimento", "Disponível"),
        ("EM DESENVOLVIMENTO", "DISPONÍVEL"),
        ("em desenvolvimento", "Disponível"),
        ("EM BREVE", "ACESSAR"),
        ("Em breve", "ACESSAR"),
        ("em breve", "ACESSAR"),
        ("Indisponível", "Disponível"),
        ("INDISPONÍVEL", "DISPONÍVEL"),
        ("Em construção", "Disponível"),
        ("EM CONSTRUÇÃO", "DISPONÍVEL"),
    ]

    for antigo, novo in substituicoes:
        s = s.replace(antigo, novo)

    return s


def corrigir_flags(segmento: str) -> str:
    s = segmento

    # Flags de bloqueio -> False/false.
    bloqueio_keys = [
        "disabled",
        "is_disabled",
        "bloqueado",
        "locked",
        "coming_soon",
        "comingSoon",
        "em_breve",
        "emBreve",
        "soon",
        "development",
        "under_development",
    ]

    for key in bloqueio_keys:
        # JS/JSON/Python com true.
        s = re.sub(
            rf'(["\']?{re.escape(key)}["\']?\s*[:=]\s*)true\b',
            r'\1false',
            s,
            flags=re.IGNORECASE,
        )

        # Python com True.
        s = re.sub(
            rf'(["\']?{re.escape(key)}["\']?\s*[:=]\s*)True\b',
            r'\1False',
            s,
        )

        # Numérico 1 -> 0.
        s = re.sub(
            rf'(["\']?{re.escape(key)}["\']?\s*[:=]\s*)1\b',
            r'\g<1>0',
            s,
            flags=re.IGNORECASE,
        )

    # Flags de ativo -> True/true.
    ativo_keys = [
        "active",
        "ativo",
        "enabled",
        "disponivel",
        "available",
        "clickable",
    ]

    for key in ativo_keys:
        s = re.sub(
            rf'(["\']?{re.escape(key)}["\']?\s*[:=]\s*)false\b',
            r'\1true',
            s,
            flags=re.IGNORECASE,
        )

        s = re.sub(
            rf'(["\']?{re.escape(key)}["\']?\s*[:=]\s*)False\b',
            r'\1True',
            s,
        )

        s = re.sub(
            rf'(["\']?{re.escape(key)}["\']?\s*[:=]\s*)0\b',
            r'\g<1>1',
            s,
            flags=re.IGNORECASE,
        )

    return s


def corrigir_links(segmento: str) -> tuple[str, bool]:
    s = segmento
    mudou_link = False

    # HTML href vazio ou placeholder.
    def repl_href(m):
        nonlocal mudou_link

        quote = m.group(1)
        valor = m.group(2)

        if is_placeholder_url(valor) or "retirada" in normalizar(valor):
            mudou_link = True
            return f'href={quote}{ROTA}{quote}'

        return m.group(0)

    s = re.sub(
        r'href\s*=\s*(["\'])(.*?)\1',
        repl_href,
        s,
        flags=re.IGNORECASE | re.DOTALL,
    )

    # Atributos data-href/data-url.
    def repl_data_href(m):
        nonlocal mudou_link

        attr = m.group(1)
        quote = m.group(2)
        valor = m.group(3)

        if is_placeholder_url(valor) or "retirada" in normalizar(valor):
            mudou_link = True
            return f'{attr}={quote}{ROTA}{quote}'

        return m.group(0)

    s = re.sub(
        r'((?:data-href|data-url|data-link|data-route|data-path)\s*)=\s*(["\'])(.*?)\2',
        repl_data_href,
        s,
        flags=re.IGNORECASE | re.DOTALL,
    )

    # Chaves em JS/JSON/Python:
    # url: "#"
    # "href": "#"
    # link = "#"
    keys = [
        "href",
        "url",
        "link",
        "route",
        "path",
        "endpoint",
        "to",
    ]

    for key in keys:
        def repl_key(m, key=key):
            nonlocal mudou_link

            prefixo = m.group(1)
            quote = m.group(2)
            valor = m.group(3)

            if is_placeholder_url(valor) or "retirada" in normalizar(valor):
                mudou_link = True
                return f'{prefixo}{quote}{ROTA}{quote}'

            return m.group(0)

        s = re.sub(
            rf'((?:["\']?{re.escape(key)}["\']?\s*[:=]\s*)(["\']))(.*?)(\2)',
            repl_key,
            s,
            flags=re.IGNORECASE | re.DOTALL,
        )

    return s, mudou_link


def remover_estilos_bloqueio(segmento: str) -> str:
    s = segmento

    s = re.sub(
        r'pointer-events\s*:\s*none\s*;?',
        '',
        s,
        flags=re.IGNORECASE,
    )

    s = re.sub(
        r'cursor\s*:\s*not-allowed\s*;?',
        'cursor: pointer;',
        s,
        flags=re.IGNORECASE,
    )

    # Evita deixar card apagado.
    s = re.sub(
        r'opacity\s*:\s*0\.[0-9]+\s*;?',
        'opacity: 1;',
        s,
        flags=re.IGNORECASE,
    )

    s = re.sub(
        r'filter\s*:\s*grayscale\([^)]*\)\s*;?',
        '',
        s,
        flags=re.IGNORECASE,
    )

    return s


def inserir_js_local_se_html_precisar(texto: str) -> str:
    """
    Fallback seguro:
    Se o arquivo é HTML e contém o card Retirada, injeta um JS direto nesse arquivo.
    Esse JS atua somente no card Retirada.
    """
    marker = "/* === PATCH DIRETO CARD RETIRADA ORIGEM REAL === */"

    if marker in texto:
        return texto

    snippet = r'''
<style>
/* === PATCH DIRETO CARD RETIRADA ORIGEM REAL === */
.card-retirada-origem-real-ativo {
    cursor: pointer !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    filter: none !important;
}
.card-retirada-origem-real-ativo * {
    pointer-events: auto !important;
}
/* === FIM PATCH DIRETO CARD RETIRADA ORIGEM REAL === */
</style>

<script>
/* === PATCH DIRETO CARD RETIRADA ORIGEM REAL === */
(function () {
    const ROTA = "/dash/retirada/";

    function norm(txt) {
        return String(txt || "")
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "");
    }

    function trocarTextos(root) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
        const nodes = [];

        while (walker.nextNode()) {
            nodes.push(walker.currentNode);
        }

        nodes.forEach(function (node) {
            let t = node.nodeValue || "";
            t = t.replace(/Em desenvolvimento/g, "Disponível");
            t = t.replace(/EM DESENVOLVIMENTO/g, "DISPONÍVEL");
            t = t.replace(/em desenvolvimento/g, "Disponível");
            t = t.replace(/EM BREVE/g, "ACESSAR");
            t = t.replace(/Em breve/g, "ACESSAR");
            t = t.replace(/em breve/g, "ACESSAR");
            node.nodeValue = t;
        });
    }

    function ativar() {
        const candidatos = Array.from(document.querySelectorAll("a, article, section, div, li"))
            .filter(function (el) {
                return norm(el.textContent).includes("retirada de equipamentos");
            })
            .map(function (el) {
                return {
                    el: el,
                    len: String(el.textContent || "").trim().length
                };
            })
            .filter(function (x) {
                return x.len >= 20 && x.len <= 1300;
            });

        if (!candidatos.length) {
            return;
        }

        candidatos.sort(function (a, b) {
            return a.len - b.len;
        });

        let card = candidatos[0].el;

        const ancestral = card.closest(
            "a, article, li, .card, .hub-card, .dash-card, .dashboard-card, .report-card, .menu-card, .portal-card"
        );

        if (ancestral && norm(ancestral.textContent).includes("retirada de equipamentos")) {
            card = ancestral;
        }

        trocarTextos(card);

        card.classList.remove("disabled", "is-disabled", "card-disabled", "card-inativo", "inativo", "soon", "coming-soon", "em-breve", "bloqueado");
        card.classList.add("card-retirada-origem-real-ativo");
        card.removeAttribute("disabled");
        card.removeAttribute("aria-disabled");
        card.style.pointerEvents = "auto";
        card.style.cursor = "pointer";
        card.style.opacity = "1";
        card.style.filter = "none";

        if (card.tagName && card.tagName.toLowerCase() === "a") {
            card.setAttribute("href", ROTA);
        } else {
            card.setAttribute("role", "link");
            card.setAttribute("tabindex", "0");
            card.onclick = function (ev) {
                if (ev.target && ev.target.closest && ev.target.closest("a")) {
                    return;
                }
                window.location.href = ROTA;
            };
        }

        card.querySelectorAll("a").forEach(function (a) {
            a.setAttribute("href", ROTA);
            a.removeAttribute("target");
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", ativar);
    } else {
        ativar();
    }

    setTimeout(ativar, 250);
    setTimeout(ativar, 800);
    setTimeout(ativar, 1600);
})();
/* === FIM PATCH DIRETO CARD RETIRADA ORIGEM REAL === */
</script>
'''

    if "{% endblock %}" in texto:
        return texto.replace("{% endblock %}", snippet + "\n\n{% endblock %}", 1)

    if "</body>" in texto:
        return texto.replace("</body>", snippet + "\n</body>", 1)

    return texto.rstrip() + "\n\n" + snippet + "\n"


def patch_segmento(segmento: str) -> tuple[str, bool]:
    original = segmento

    s = segmento
    s = corrigir_textos(s)
    s = corrigir_flags(s)
    s = remover_classes_bloqueio(s)
    s = remover_estilos_bloqueio(s)
    s, mudou_link = corrigir_links(s)

    mudou = s != original

    return s, mudou or mudou_link


def criar_janelas_linhas(texto: str):
    linhas = texto.splitlines(keepends=True)
    indices = []

    for i, linha in enumerate(linhas):
        n = normalizar(linha)
        if "retirada de equipamentos" in n or ("retirada" in n and "equipamento" in n):
            indices.append(i)

    if not indices:
        return linhas, []

    janelas = []

    for idx in indices:
        ini = max(0, idx - 30)
        fim = min(len(linhas), idx + 55)
        janelas.append((ini, fim))

    # Une janelas sobrepostas.
    janelas.sort()
    unidas = []

    for ini, fim in janelas:
        if not unidas:
            unidas.append([ini, fim])
            continue

        last = unidas[-1]

        if ini <= last[1]:
            last[1] = max(last[1], fim)
        else:
            unidas.append([ini, fim])

    return linhas, [(a, b) for a, b in unidas]


def patch_arquivo(path: Path) -> dict:
    texto, encoding = read_text_safe(path)
    original = texto

    linhas, janelas = criar_janelas_linhas(texto)

    if not janelas:
        return {
            "arquivo": str(path),
            "candidato": False,
            "alterado": False,
            "motivo": "não contém card Retirada",
        }

    alterou = False

    # Processa de trás para frente para não bagunçar índices.
    for ini, fim in reversed(janelas):
        segmento = "".join(linhas[ini:fim])
        novo_segmento, mudou = patch_segmento(segmento)

        if mudou:
            linhas[ini:fim] = [novo_segmento]
            alterou = True

    texto = "".join(linhas)

    # Se for HTML, injeta fallback direto no próprio arquivo real.
    if path.suffix.lower() in {".html", ".htm"}:
        antes = texto
        texto = inserir_js_local_se_html_precisar(texto)

        if texto != antes:
            alterou = True

    if texto != original:
        backup = backup_file(path)
        write_text_safe(path, texto, encoding)

        return {
            "arquivo": str(path),
            "candidato": True,
            "alterado": True,
            "backup": str(backup),
            "janelas": len(janelas),
        }

    return {
        "arquivo": str(path),
        "candidato": True,
        "alterado": False,
        "motivo": "card encontrado, mas nada foi alterado",
        "janelas": len(janelas),
    }


def listar_arquivos():
    arquivos = []

    for p in ROOT.rglob("*"):
        if p.is_file() and not deve_ignorar(p):
            arquivos.append(p)

    return arquivos


def main():
    print("=" * 72)
    print("ATIVAR CARD RETIRADA — ORIGEM REAL")
    print("=" * 72)
    print(f"[ROOT] {ROOT}")
    print(f"[ROTA] {ROTA}")
    print("-" * 72)

    arquivos = listar_arquivos()
    resultados = []

    for p in arquivos:
        try:
            resultado = patch_arquivo(p)

            if resultado.get("candidato"):
                resultados.append(resultado)

        except Exception as e:
            resultados.append({
                "arquivo": str(p),
                "candidato": True,
                "alterado": False,
                "erro": str(e),
            })

    linhas_relatorio = []
    linhas_relatorio.append("DIAGNÓSTICO CARD RETIRADA\n")
    linhas_relatorio.append(f"ROOT: {ROOT}\n")
    linhas_relatorio.append(f"ROTA: {ROTA}\n")
    linhas_relatorio.append("=" * 72 + "\n\n")

    if not resultados:
        linhas_relatorio.append("Nenhum arquivo contendo 'Retirada de Equipamentos' foi encontrado.\n")
    else:
        for r in resultados:
            linhas_relatorio.append(f"Arquivo: {r.get('arquivo')}\n")
            linhas_relatorio.append(f"Alterado: {'SIM' if r.get('alterado') else 'NÃO'}\n")

            if r.get("backup"):
                linhas_relatorio.append(f"Backup: {r.get('backup')}\n")

            if r.get("janelas") is not None:
                linhas_relatorio.append(f"Janelas analisadas: {r.get('janelas')}\n")

            if r.get("motivo"):
                linhas_relatorio.append(f"Motivo: {r.get('motivo')}\n")

            if r.get("erro"):
                linhas_relatorio.append(f"Erro: {r.get('erro')}\n")

            linhas_relatorio.append("-" * 72 + "\n")

    RELATORIO.write_text("".join(linhas_relatorio), encoding="utf-8")

    alterados = [r for r in resultados if r.get("alterado")]

    if resultados:
        print("[INFO] Arquivos candidatos encontrados:")
        for r in resultados:
            status = "ALTERADO" if r.get("alterado") else "NÃO ALTERADO"
            print(f" - {status}: {r.get('arquivo')}")
    else:
        print("[AVISO] Nenhum arquivo com 'Retirada de Equipamentos' foi encontrado.")

    print("-" * 72)

    if alterados:
        print("[CONCLUÍDO] O card Retirada foi alterado na origem encontrada.")
        print("Agora pare/suba o Flask e use Ctrl + F5 no navegador.")
        print("Resultado esperado:")
        print("Retirada de Equipamentos | Disponível | ACESSAR")
        print("Clique esperado: /dash/retirada/")
    else:
        print("[ATENÇÃO] Nenhum arquivo foi alterado.")
        print("Abra o relatório gerado para ver onde o script procurou.")

    print(f"[RELATÓRIO] {RELATORIO}")
    print("=" * 72)


if __name__ == "__main__":
    main()
