def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    bkp = path.with_name(f"{path.stem}.backup_fix12_{stamp}{path.suffix}")
    shutil.copy2(path, bkp)
    return bkp


