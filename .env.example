# Copie para .env. Variáveis já definidas no sistema têm prioridade.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=safra
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=60
# Defina uma chave aleatória e estável no servidor.
SECRET_KEY=
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
CACHE_TTL_SECONDS=300
PRELOAD_DATA=0
ENABLE_DIAGNOSTICS=0
