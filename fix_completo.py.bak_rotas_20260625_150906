PATCH_MARKERS = [
    "PATCH_V4_RETIRADA_ATIVA",
    "PATCH LIMPO RETIRADA ATIVA",
    "PATCH DIRETO CARD RETIRADA ORIGEM REAL",
    "HUB RETIRADA ATIVA V3 GLOBAL",
    "ATIVACAO SEGURA CARD RETIRADA V2",
]


def agora():
    return datetime.now().strftime("%Y%m%d_%H%M%S")


def backup_file(path):
    if path.exists():
        backup = path.with_suffix(path.suffix + ".bak_correcao_pos_retirada_" + agora())
        shutil.copy2(path, backup)
        print(f"[BACKUP] {path.name} -> {backup.name}")
        return backup
    return None


def read_text_safe(path):
    try:
        return path.read_text(encoding="utf-8"), "utf-8"
    except UnicodeDecodeError:
        return path.read_text(encoding="latin-1"), "latin-1"


def write_text_safe(path, text, encoding="utf-8"):
    path.write_text(text, encoding=encoding)


def remover_bloco_com_marker(html, marker):
    """
    Remove blocos style/script que contenham patches antigos.
    """
    mudou = True

    while mudou:
        mudou = False
        idx = html.find(marker)

        if idx == -1:
            break

        style_ini = html.rfind("<style", 0, idx)
        script_ini = html.rfind("<script", 0, idx)

        candidatos_ini = [x for x in [style_ini, script_ini] if x != -1]
        ini = max(candidatos_ini) if candidatos_ini else idx

        style_fim = html.find("</style>", idx)
        script_fim = html.find("</script>", idx)

        candidatos_fim = []

        if style_fim != -1:
            candidatos_fim.append(style_fim + len("</style>"))

        if script_fim != -1:
            candidatos_fim.append(script_fim + len("</script>"))

        fim = min(candidatos_fim) if candidatos_fim else idx + len(marker)

        html = html[:ini].rstrip() + "\n" + html[fim:].lstrip()
        mudou = True

    return html


def limpar_patches_antigos(path):
    if not path.exists():
        return False

    html, encoding = read_text_safe(path)
    original = html

    for marker in PATCH_MARKERS:
        html = remover_bloco_com_marker(html, marker)

    if html != original:
        backup_file(path)
        write_text_safe(path, html, encoding)
        print(f"[LIMPO] Patches antigos removidos de: {path.name}")
        return True

    print(f"[INFO] Sem patches antigos detectados em: {path.name}")
    return False


def corrigir_data_db_cache():
    """
    Corrige o erro:
    ImportError: cannot import name '_DF_CACHE' from 'data.db'
    """
    if not DB_FILE.exists():
        print(f"[AVISO] data/db.py nao encontrado: {DB_FILE}")
        return False

    txt, encoding = read_text_safe(DB_FILE)
    original = txt

    inserts = []

    if re.search(r"^\s*_DF_CACHE\s*=", txt, flags=re.MULTILINE) is None:
        inserts.append("_DF_CACHE = {}")

    if re.search(r"^\s*_OPTIONS_CACHE\s*=", txt, flags=re.MULTILINE) is None:
        inserts.append("_OPTIONS_CACHE = {}")

    if not inserts:
        print("[INFO] data/db.py ja possui _DF_CACHE/_OPTIONS_CACHE.")
        return False

    bloco = (
        "\n# Compatibilidade com dashboards legados/migrados\n"
        + "\n".join(inserts)
        + "\n"
    )

    linhas = txt.splitlines(keepends=True)
    idx = 0

    for i, line in enumerate(linhas):
        stripped = line.strip()

        if (
            stripped.startswith("import ")
            or stripped.startswith("from ")
            or stripped == ""
            or stripped.startswith("#")
        ):
            idx = i + 1
            continue

        break

    txt = "".join(linhas[:idx]) + bloco + "".join(linhas[idx:])

    if txt != original:
        backup_file(DB_FILE)
        write_text_safe(DB_FILE, txt, encoding)
        print("[OK] data/db.py corrigido com variaveis de cache.")
        return True

    return False


