def diagnosticar_rotas_hub():
    """
    Apenas gera pistas de qual rota renderiza o Hub.
    Nao altera rotas automaticamente.
    """
    achados = []

    for py in ROOT.rglob("*.py"):
        s = str(py).lower()

        if "__pycache__" in s or ".bak" in s or "backup" in s:
            continue

        try:
            txt, _ = read_text_safe(py)
        except Exception:
            continue

        low = txt.lower()

        if (
            "hub_desconexao" in low
            or "adm/desconexao" in low
            or "areas/adm/desconexao" in low
            or "desconexao" in low and "render_template" in low
        ):
            linhas = []

            for i, line in enumerate(txt.splitlines(), start=1):
                l = line.lower()

                if (
                    "hub_desconexao" in l
                    or "adm/desconexao" in l
                    or "areas/adm/desconexao" in l
                    or ("render_template" in l and "desconexao" in l)
                ):
                    linhas.append((i, line.strip()))

            if linhas:
                achados.append((py, linhas))

    return achados


def gerar_relatorio(alteracoes):
    linhas = []
    linhas.append("RELATORIO CORRECAO HUB E ERROS POS RETIRADA\n")
    linhas.append(f"ROOT: {ROOT}\n")
    linhas.append("=" * 72 + "\n\n")

    for item, status in alteracoes.items():
        linhas.append(f"{item}: {'SIM' if status else 'NAO'}\n")

    if HUB_FILE.exists():
        txt, _ = read_text_safe(HUB_FILE)
        linhas.append("\nVALIDACAO HUB\n")
        linhas.append(f"Contem /dash/retirada/: {'SIM' if '/dash/retirada/' in txt else 'NAO'}\n")
        linhas.append(f"Contem ACESSAR: {'SIM' if 'ACESSAR' in txt else 'NAO'}\n")
        linhas.append(f"Contem EM BREVE: {'SIM' if 'EM BREVE' in txt else 'NAO'}\n")
        linhas.append(f"Contem numeros 01/02/03: {'SIM' if '>01<' in txt or '>02<' in txt or '>03<' in txt else 'NAO'}\n")
        linhas.append(f"Contem icones antigos: {'SIM' if '★' in txt and '☑' in txt and '▣' in txt else 'NAO'}\n")

    if DB_FILE.exists():
        txt, _ = read_text_safe(DB_FILE)
        linhas.append("\nVALIDACAO DATA/DB\n")
        linhas.append(f"_DF_CACHE presente: {'SIM' if '_DF_CACHE' in txt else 'NAO'}\n")
        linhas.append(f"_OPTIONS_CACHE presente: {'SIM' if '_OPTIONS_CACHE' in txt else 'NAO'}\n")

    linhas.append("\nROTAS POSSIVEIS DO HUB\n")
    achados = diagnosticar_rotas_hub()

    if achados:
        for py, refs in achados:
            linhas.append(f"\nArquivo: {py}\n")
            for n, line in refs:
                linhas.append(f"  Linha {n}: {line}\n")
    else:
        linhas.append("Nenhuma referencia clara encontrada.\n")

    RELATORIO.write_text("".join(linhas), encoding="utf-8")
    print(f"[RELATORIO] {RELATORIO}")


def main():
    print("=" * 72)
    print("CORRECAO CONSOLIDADA - HUB + ERROS POS RETIRADA")
    print("=" * 72)
    print(f"[ROOT] {ROOT}")
