"""Conexao MySQL compartilhada + cache de DataFrames otimizado."""
from sqlalchemy import create_engine
import pandas as pd

DB_URL = "mysql+pymysql://root:@localhost:3306/safra"

_DF_CACHE = {}


def get_engine():
    return create_engine(DB_URL, pool_pre_ping=True)


def load_table(table_name, categorical_cols=None, force_reload=False):
    """
    Carrega tabela do MySQL com cache em memoria e otimizacao opcional.

    Args:
        table_name: nome da tabela MySQL
        categorical_cols: lista de colunas para converter em 'category' (economia de RAM)
        force_reload: ignora cache e forca reload

    Returns:
        DataFrame (do cache, ou recem-carregado)
    """
    if force_reload or table_name not in _DF_CACHE:
        try:
            engine = get_engine()
            df = pd.read_sql(f"SELECT * FROM {table_name}", engine)
            engine.dispose()

            mem_antes = df.memory_usage(deep=True).sum() / 1024**2

            if categorical_cols:
                aplicadas = []
                for col in categorical_cols:
                    if col in df.columns:
                        df[col] = df[col].astype("category")
                        aplicadas.append(col)
                mem_depois = df.memory_usage(deep=True).sum() / 1024**2
                economia = (1 - mem_depois / mem_antes) * 100 if mem_antes > 0 else 0
                print(
                    f"[DB] {table_name}: {len(df):,} linhas | "
                    f"RAM {mem_antes:.1f}MB -> {mem_depois:.1f}MB "
                    f"(-{economia:.0f}%) | categoricas: {len(aplicadas)}"
                )
            else:
                print(
                    f"[DB] {table_name}: {len(df):,} linhas, "
                    f"{mem_antes:.1f}MB"
                )

            _DF_CACHE[table_name] = df
        except Exception as e:
            print(f"[DB] ERRO ao carregar {table_name}: {e}")
            _DF_CACHE[table_name] = pd.DataFrame()
    return _DF_CACHE[table_name]


def clear_cache():
    """Limpa todo cache."""
    _DF_CACHE.clear()