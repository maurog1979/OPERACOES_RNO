def read_text_safe(path: Path) -> tuple[str, str]:
    for enc in ("utf-8-sig", "utf-8", "cp1252", "latin-1"):
        try:
            return path.read_text(encoding=enc), enc
        except UnicodeDecodeError:
            pass
    return path.read_text(errors="replace"), "utf-8"


