]

CATEGORICAL_COLS = [
    "SAFRA",
    "DS_TIPO_DESCONEXAO",
    "NM_CIDADE",
    "PENDENCIA",
    "FAIXA_LOG",
    "ANL_MOTIVO_REAGENDA",
    "ANL_QUEBRA_RESPONSAVEL",
