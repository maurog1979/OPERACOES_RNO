@bp.route("/")
def index():
    return render_template("dash_log.html")


@bp.route("/api/options")
def api_options():
    """
    Opções em cascata:
    - Recebe os filtros atuais pela query string.
    - Para cada filtro, monta opções considerando os demais filtros.
    - Retorna SEMPRE JSON.
    """
    try:
        df = prepare_df()
        selected = {col: request.args.getlist(col) for col in FILTROS_CASCATA}

        payload = {}

        for alvo in FILTROS_CASCATA:
            dfx = df.copy()

            for col, vals in selected.items():
                if col == alvo:
                    continue

                vals = limpar_valores(vals)
                if col in dfx.columns and vals:
                    dfx = dfx[dfx[col].fillna("").astype(str).isin(vals)]

            payload[alvo] = get_options(dfx, alvo)

        return jsonify(payload)

    except Exception as e:
        return jsonify({
            "error": True,
            "endpoint": "/dash/log/api/options",
            "message": str(e),
        }), 500


@bp.route("/api/data")
def api_data():
    """
    Dados principais:
    - Aplica filtros.
    - Calcula KPIs.
    - Monta 6 gráficos Plotly.
    - Retorna SEMPRE JSON.
    """
    try:
        df = prepare_df()
        filters = {col: request.args.getlist(col) for col in FILTROS_CASCATA}
        dff = apply_filters(df, filters)

        kpis = montar_kpis(dff)

        g1 = grafico_faixa_log(dff)
        g2 = grafico_com_sem_log(dff)
        g3 = grafico_barra_horizontal(
            dff,
            "ANL_MOTIVO_REAGENDA",
            "Top Motivos de Reagenda",
            top=15,
            cor=CORES["orange"],
        )
        g4 = grafico_barra_horizontal(
            dff,
            "ANL_QUEBRA_RESPONSAVEL",
            "Responsáveis pela Quebra",
            top=15,
            cor=CORES["red"],
        )
        g5 = grafico_tipo_por_log(dff)
        g6 = grafico_cidades_criticas(dff)

        payload = {
            "kpis": kpis,
            "g1": fig_to_json(g1),
            "g2": fig_to_json(g2),
            "g3": fig_to_json(g3),
            "g4": fig_to_json(g4),
            "g5": fig_to_json(g5),
            "g6": fig_to_json(g6),
        }

        return jsonify(payload)

    except Exception as e:
        return jsonify({
            "error": True,
            "endpoint": "/dash/log/api/data",
            "message": str(e),
        }), 500
