def prepare_df():
    """
    Carrega a tabela principal.
    Tenta usar categorical_cols quando o data.db suporta.
    Se não suportar, chama load_table simples.
    """
    try:
        df = load_table(TABLE, categorical_cols=CATEGORICAL_COLS)
    except TypeError:
        df = load_table(TABLE)

    if df is None:
        df = pd.DataFrame()

    # Garante que as colunas usadas no dashboard existam.
    for col in CATEGORICAL_COLS:
        if col not in df.columns:
            df[col] = ""

    # Normalização leve para filtros e agrupamentos.
    for col in CATEGORICAL_COLS:
        df[col] = df[col].fillna("").astype(str).str.strip()

    return df


def limpar_valores(vals):
    saida = []
    for v in vals or []:
        s = str(v).strip()
        if s and s.lower() != "nan":
            saida.append(s)
    return saida


def apply_filters(df, filters):
    if df is None or df.empty:
        return df

    dff = df.copy()

    for col, vals in filters.items():
        vals = limpar_valores(vals)
        if col in dff.columns and vals:
            dff = dff[dff[col].fillna("").astype(str).isin(vals)]

    return dff


def get_options(df, col):
    if df is None or df.empty or col not in df.columns:
        return []

    vals = (
        df[col]
        .dropna()
        .astype(str)
        .str.strip()
    )

    vals = vals[(vals != "") & (vals.str.lower() != "nan")]
    return sorted(vals.unique().tolist())


def estilo(fig, titulo="", height=350):
    fig.update_layout(
        title=dict(text=titulo, font=dict(size=14, color="#333"), x=0.01),
        template="plotly_white",
        height=height,
        margin=dict(l=20, r=20, t=50, b=35),
        plot_bgcolor="white",
        paper_bgcolor="white",
        font=dict(family="Inter, Segoe UI, sans-serif", size=11),
        legend=dict(
            font_size=10,
            orientation="h",
            yanchor="bottom",
            y=-0.25,
            x=0.5,
            xanchor="center",
        ),
    )
    return fig


def fig_vazia(msg="Sem dados"):
    fig = go.Figure()
    fig.add_annotation(
        text=msg,
        showarrow=False,
        font_size=16,
        font_color="#999",
        x=0.5,
        y=0.5,
    )
    fig.update_layout(
        template="plotly_white",
        height=350,
        margin=dict(l=20, r=20, t=40, b=20),
        plot_bgcolor="white",
        paper_bgcolor="white",
        xaxis=dict(visible=False),
        yaxis=dict(visible=False),
    )
    return fig


def _plotly_sanitize(obj):
    """
    Converte objetos não serializáveis do Plotly/Pandas/Numpy para JSON comum.
    Também remove templates gigantes que podem quebrar/contaminar a renderização.
    """
    if obj is None:
        return None

    if isinstance(obj, (str, int, float, bool)):
        return obj

    if isinstance(obj, dict):
        cleaned = {}
        for k, v in obj.items():
            # Remove template completo do Plotly para evitar JSON gigante e renderização estranha.
            if k == "template":
                continue

            # Se por algum motivo vierem arrays binários já montados, não repassa.
            # A função fig.to_plotly_json() normalmente evita isso, mas esta proteção fica como fallback.
            if isinstance(v, dict) and "bdata" in v and "dtype" in v:
                continue

            cleaned[str(k)] = _plotly_sanitize(v)
        return cleaned

    if isinstance(obj, (list, tuple, set)):
        return [_plotly_sanitize(v) for v in obj]

    # Numpy arrays, pandas Series/Index e similares
    if hasattr(obj, "tolist"):
        try:
            return _plotly_sanitize(obj.tolist())
        except Exception:
            pass

    # Pandas Timestamp / datetime-like
    if hasattr(obj, "isoformat"):
        try:
            return obj.isoformat()
        except Exception:
            pass

    return obj


def fig_to_json(fig):
    """
    Serialização segura para Plotly.js no navegador.
    Evita:
    - layout.template gigante
    - arrays binários bdata/dtype
    - objetos numpy/pandas crus
    """
    try:
        fig.update_layout(template=None)
    except Exception:
        pass

    raw = fig.to_plotly_json()

    if isinstance(raw, dict) and "layout" in raw and isinstance(raw["layout"], dict):
        raw["layout"].pop("template", None)

    safe = _plotly_sanitize(raw)

    # Round-trip com PlotlyJSONEncoder para garantir JSON limpo.
    return json.loads(json.dumps(safe, cls=PlotlyJSONEncoder, ensure_ascii=False))


def count_by_col(df, col, top=15):
    if df is None or df.empty or col not in df.columns:
        return pd.DataFrame(columns=[col, "QTDE"])

    s = df[col].fillna("").astype(str).str.strip()
    s = s[(s != "") & (s.str.lower() != "nan")]

    if s.empty:
        return pd.DataFrame(columns=[col, "QTDE"])

    out = (
        s.value_counts()
        .head(top)
        .rename_axis(col)
        .reset_index(name="QTDE")
    )
    return out


def grafico_barra_horizontal(df, col, titulo, top=15, cor="#E60000"):
    base = count_by_col(df, col, top=top)

    if base.empty:
        return fig_vazia("Sem dados para " + titulo)

    base = base.sort_values("QTDE", ascending=True)

    fig = px.bar(
        base,
        x="QTDE",
        y=col,
        orientation="h",
        text="QTDE",
        color_discrete_sequence=[cor],
    )
    fig.update_traces(textposition="outside", cliponaxis=False)
    fig.update_yaxes(title="")
    fig.update_xaxes(title="Quantidade")
    return estilo(fig, titulo=titulo)


def grafico_barra_vertical(df, col, titulo, top=15, cor="#E60000"):
    base = count_by_col(df, col, top=top)

    if base.empty:
        return fig_vazia("Sem dados para " + titulo)

    fig = px.bar(
        base,
        x=col,
        y="QTDE",
        text="QTDE",
        color_discrete_sequence=[cor],
    )
    fig.update_traces(textposition="outside", cliponaxis=False)
    fig.update_xaxes(title="", tickangle=-25)
    fig.update_yaxes(title="Quantidade")
    return estilo(fig, titulo=titulo)


def grafico_faixa_log(df):
    col = "FAIXA_LOG"

    if df is None or df.empty or col not in df.columns:
        return fig_vazia("Sem dados de FAIXA_LOG")

    base = count_by_col(df, col, top=20)

    if base.empty:
        return fig_vazia("Sem dados de FAIXA_LOG")

    ordem = ["SEM LOG", "1x", "2-3x", "4-5x", "6x+"]
    base["_ordem"] = base[col].apply(lambda x: ordem.index(x) if x in ordem else 99)
    base = base.sort_values("_ordem").drop(columns=["_ordem"])

    fig = px.bar(
        base,
        x=col,
        y="QTDE",
        text="QTDE",
        color=col,
        color_discrete_map=CORES_LOG,
    )
    fig.update_traces(textposition="outside", cliponaxis=False)
    fig.update_xaxes(title="")
    fig.update_yaxes(title="Quantidade")
    return estilo(fig, titulo="Distribuição por Faixa LOG")


def grafico_com_sem_log(df):
    if df is None or df.empty or "FAIXA_LOG" not in df.columns:
        return fig_vazia("Sem dados de LOG")

    faixa = df["FAIXA_LOG"].fillna("").astype(str).str.strip()
    sem_log = int((faixa == FAIXA_SEM_LOG).sum())
    com_log = int(((faixa != "") & (faixa != FAIXA_SEM_LOG)).sum())

    base = pd.DataFrame({
        "STATUS": ["COM LOG", "SEM LOG"],
        "QTDE": [com_log, sem_log],
    })

    if base["QTDE"].sum() == 0:
        return fig_vazia("Sem dados de LOG")

    fig = px.pie(
        base,
        names="STATUS",
        values="QTDE",
        hole=0.55,
        color="STATUS",
        color_discrete_map={
            "COM LOG": CORES["orange"],
            "SEM LOG": CORES["green"],
        },
    )
    fig.update_traces(textinfo="percent+label")
    return estilo(fig, titulo="Com LOG x Sem LOG")


def grafico_tipo_por_log(df):
    if df is None or df.empty:
        return fig_vazia("Sem dados por tipo")

    if "DS_TIPO_DESCONEXAO" not in df.columns or "FAIXA_LOG" not in df.columns:
        return fig_vazia("Colunas de tipo/log não encontradas")

    dff = df.copy()
    dff["STATUS_LOG"] = dff["FAIXA_LOG"].apply(
        lambda x: "SEM LOG" if str(x).strip() == FAIXA_SEM_LOG else "COM LOG"
    )

    base = (
        dff.groupby(["DS_TIPO_DESCONEXAO", "STATUS_LOG"], observed=False)
        .size()
        .reset_index(name="QTDE")
    )

    base = base[
        (base["DS_TIPO_DESCONEXAO"].astype(str).str.strip() != "")
        & (base["QTDE"] > 0)
    ]

    if base.empty:
        return fig_vazia("Sem dados por tipo")

    totais = (
        base.groupby("DS_TIPO_DESCONEXAO", observed=False)["QTDE"]
        .sum()
        .sort_values(ascending=False)
        .head(12)
        .index
        .tolist()
    )
    base = base[base["DS_TIPO_DESCONEXAO"].isin(totais)]

    fig = px.bar(
        base,
        x="DS_TIPO_DESCONEXAO",
        y="QTDE",
        color="STATUS_LOG",
        barmode="stack",
        text="QTDE",
        color_discrete_map={
            "COM LOG": CORES["orange"],
            "SEM LOG": CORES["green"],
        },
    )
    fig.update_traces(textposition="inside")
    fig.update_xaxes(title="", tickangle=-25)
    fig.update_yaxes(title="Quantidade")
    return estilo(fig, titulo="LOG por Tipo de Desconexão")


def grafico_cidades_criticas(df):
    if df is None or df.empty:
        return fig_vazia("Sem dados por cidade")

    if "NM_CIDADE" not in df.columns or "FAIXA_LOG" not in df.columns:
        return fig_vazia("Colunas de cidade/log não encontradas")

    dff = df.copy()
    dff["COM_LOG"] = dff["FAIXA_LOG"].apply(
        lambda x: 1 if str(x).strip() not in ["", FAIXA_SEM_LOG] else 0
    )

    base = (
        dff.groupby("NM_CIDADE", observed=False)["COM_LOG"]
        .sum()
        .sort_values(ascending=False)
        .head(15)
        .reset_index(name="QTDE_COM_LOG")
    )

    base = base[
        (base["NM_CIDADE"].astype(str).str.strip() != "")
        & (base["QTDE_COM_LOG"] > 0)
    ]

    if base.empty:
        return fig_vazia("Sem cidades com LOG")

    base = base.sort_values("QTDE_COM_LOG", ascending=True)

    fig = px.bar(
        base,
        x="QTDE_COM_LOG",
        y="NM_CIDADE",
        orientation="h",
        text="QTDE_COM_LOG",
        color_discrete_sequence=[CORES["red"]],
    )
    fig.update_traces(textposition="outside", cliponaxis=False)
    fig.update_yaxes(title="")
    fig.update_xaxes(title="Quantidade com LOG")
    return estilo(fig, titulo="Cidades com Maior Volume de LOG")


def montar_kpis(df):
    total = int(len(df)) if df is not None else 0

    if df is None or df.empty or "FAIXA_LOG" not in df.columns:
        return {
            "total": total,
            "com_log": 0,
            "sem_log": 0,
            "criticos": 0,
            "pct_log": 0,
        }

    faixa = df["FAIXA_LOG"].fillna("").astype(str).str.strip()

    sem_log = int((faixa == FAIXA_SEM_LOG).sum())
    com_log = int(((faixa != "") & (faixa != FAIXA_SEM_LOG)).sum())
    criticos = int((faixa == FAIXA_CRITICA).sum())
    pct_log = round((com_log / total) * 100, 1) if total else 0

    return {
        "total": total,
        "com_log": com_log,
        "sem_log": sem_log,
        "criticos": criticos,
        "pct_log": pct_log,
    }


