{% extends "base.html" %}
{% block content %}
<!-- ============ CDN (Choices + Plotly) ============ -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css">
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>

<style>
  .parc-wrap { padding: 16px 24px 32px; background:#F5F6FA; min-height: calc(100vh - 60px); }
  .parc-title-bar { display:flex; justify-content:space-between; align-items:center;
                    background:#fff; padding:14px 20px; border-radius:10px;
                    box-shadow:0 1px 4px rgba(0,0,0,.06); margin-bottom:14px; }
  .parc-title-bar h2 { margin:0; font-size:1.05rem; color:#222; font-weight:600; }
  .parc-title-bar .back { background:#E60000; color:#fff; border:none; padding:7px 14px;
                          border-radius:6px; text-decoration:none; font-size:.85rem; }
  .parc-title-bar .back:hover { background:#c50000; }

  .parc-filter-bar { display:grid; grid-template-columns:repeat(4,1fr); gap:12px;
                     background:#fff; padding:14px; border-radius:10px;
                     box-shadow:0 1px 4px rgba(0,0,0,.06); margin-bottom:14px; }
  .parc-filter-bar label { display:block; font-size:.72rem; font-weight:600;
                           color:#555; margin-bottom:4px; text-transform:uppercase; }
  .parc-filter-bar .choices { font-size:.85rem; }
  .choices__list--dropdown, .choices__list[aria-expanded] { z-index:9999 !important; }

  .parc-kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:14px; }
  .parc-kpi-card { background:#fff; border-radius:10px; padding:14px;
                   box-shadow:0 1px 4px rgba(0,0,0,.06); text-align:center;
                   border-top:3px solid #ccc; }
  .parc-kpi-icon { font-size:1.6rem; margin-bottom:4px; }
  .parc-kpi-label { font-size:.72rem; color:#777; text-transform:uppercase; margin-bottom:4px; }
  .parc-kpi-value { font-size:1.6rem; font-weight:700; }

  .parc-section { background:#fff; padding:10px 16px; border-radius:8px;
                  margin:14px 0 10px; font-weight:600; font-size:.85rem;
                  color:#444; border-left:4px solid #E60000;
                  box-shadow:0 1px 4px rgba(0,0,0,.06); text-transform:uppercase; }
  .parc-row { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-bottom:6px; }
  .parc-graph-card { background:#fff; border-radius:10px; padding:10px;
                     box-shadow:0 1px 4px rgba(0,0,0,.06); }

  .parc-loading { position:fixed; inset:0; background:rgba(255,255,255,.75);
                  display:none; align-items:center; justify-content:center;
                  z-index:99999; flex-direction:column; gap:10px; }
  .parc-loading .spin { width:48px; height:48px; border:4px solid #ddd;
                        border-top-color:#E60000; border-radius:50%;
                        animation: parc-spin 1s linear infinite; }
  @keyframes parc-spin { to { transform: rotate(360deg); } }

  @media (max-width: 1100px) {
    .parc-filter-bar, .parc-kpis, .parc-row { grid-template-columns:repeat(2,1fr); }
  }
  @media (max-width: 640px) {
    .parc-filter-bar, .parc-kpis, .parc-row { grid-template-columns:1fr; }
  }
</style>

<div class="parc-wrap">
  <div class="parc-title-bar">
    <h2>🤝 DESCONEXAO RNO — PARCEIRAS</h2>
    <a class="back" href="/areas/adm/desconexao/">⬅ Voltar</a>
  </div>

  <div class="parc-filter-bar">
    <div><label>SAFRA</label>
      <select id="parc-safra" multiple></select></div>
    <div><label>TIPO DESCONEXAO</label>
      <select id="parc-tipo" multiple></select></div>
    <div><label>CIDADE</label>
      <select id="parc-cidade" multiple></select></div>
    <div><label>PENDENCIA</label>
      <select id="parc-pend" multiple></select></div>
  </div>

  <div class="parc-kpis" id="parc-kpis"></div>

  <div class="parc-section">RECUPERACAO POR PARCEIRA</div>
  <div class="parc-row">
    <div class="parc-graph-card"><div id="parc-g1" style="height:400px"></div></div>
    <div class="parc-graph-card"><div id="parc-g2" style="height:400px"></div></div>
  </div>

  <div class="parc-section">PARCEIRA x SAFRA E TIPO</div>
  <div class="parc-row">
    <div class="parc-graph-card"><div id="parc-g3" style="height:400px"></div></div>
    <div class="parc-graph-card"><div id="parc-g4" style="height:400px"></div></div>
  </div>

  <div class="parc-section">PENDENTES E CONCLUSAO</div>
  <div class="parc-row">
    <div class="parc-graph-card"><div id="parc-g5" style="height:400px"></div></div>
    <div class="parc-graph-card"><div id="parc-g6" style="height:400px"></div></div>
  </div>
</div>

<div class="parc-loading" id="parc-loading">
  <div class="spin"></div>
  <div style="font-size:.85rem; color:#555">Carregando dados...</div>
</div>

<script>
(function() {
  const FIELDS = ["SAFRA", "DS_TIPO_DESCONEXAO", "NM_CIDADE", "PENDENCIA"];
  const SLUG   = { SAFRA:"safra", DS_TIPO_DESCONEXAO:"tipo",
                   NM_CIDADE:"cidade", PENDENCIA:"pend" };
  const SELECTS = {};
  const CHOICES = {};
  let debounceTimer = null;
  let initialized = false;

  function init() {
    if (typeof Choices === "undefined" || typeof Plotly === "undefined") {
      setTimeout(init, 120);
      return;
    }
    if (initialized) return;
    initialized = true;

    FIELDS.forEach(f => {
      const el = document.getElementById("parc-" + SLUG[f]);
      SELECTS[f] = el;
      CHOICES[f] = new Choices(el, {
        removeItemButton: true,
        placeholderValue: "Todos...",
        searchPlaceholderValue: "Buscar...",
        shouldSort: false,
        itemSelectText: "",
      });
      el.addEventListener("change", onFilterChange);
    });
    refresh();
  }

  function onFilterChange() {
    showLoading(true);
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(refresh, 250);
  }

  function getFilters() {
    const out = {};
    FIELDS.forEach(f => {
      const vals = Array.from(SELECTS[f].selectedOptions).map(o => o.value);
      if (vals.length) out[f] = vals.join("||");
    });
    return out;
  }

  async function refresh() {
    showLoading(true);
    const filters = getFilters();
    const qs = new URLSearchParams(filters).toString();
    try {
      const [optsR, dataR] = await Promise.all([
        fetch("/dash/parceiras/api/options?" + qs),
        fetch("/dash/parceiras/api/data?" + qs),
      ]);
      const opts = await optsR.json();
      const data = await dataR.json();
      updateOptions(opts, filters);
      renderKPIs(data.empty ? null : data.kpis);
      renderFigs(data.empty ? {} : (data.figs || {}));
    } catch (e) {
      console.error("[parceiras] erro:", e);
    } finally {
      showLoading(false);
    }
  }

  function updateOptions(opts, filters) {
    FIELDS.forEach(f => {
      const current = filters[f] ? filters[f].split("||") : [];
      const list = (opts[f] || []).map(v => ({
        value: v, label: v, selected: current.includes(v),
      }));
      CHOICES[f].clearStore();
      CHOICES[f].setChoices(list, "value", "label", true);
    });
  }

  function fmt(n) { return (Number(n) || 0).toLocaleString("pt-BR"); }

  function renderKPIs(k) {
    const wrap = document.getElementById("parc-kpis");
    if (!k) { wrap.innerHTML = ""; return; }
    wrap.innerHTML = `
      <div class="parc-kpi-card" style="border-top-color:#1565C0">
        <div class="parc-kpi-icon" style="color:#1565C0">📋</div>
        <div class="parc-kpi-label">TEM ANALITICO</div>
        <div class="parc-kpi-value" style="color:#1565C0">${fmt(k.tem_analitico)}</div>
      </div>
      <div class="parc-kpi-card" style="border-top-color:#F57C00">
        <div class="parc-kpi-icon" style="color:#F57C00">👥</div>
        <div class="parc-kpi-label">PARCEIRAS</div>
        <div class="parc-kpi-value" style="color:#F57C00">${fmt(k.parceiras)}</div>
      </div>
      <div class="parc-kpi-card" style="border-top-color:#2E7D32">
        <div class="parc-kpi-icon" style="color:#2E7D32">📈</div>
        <div class="parc-kpi-label">% RECUPERACAO</div>
        <div class="parc-kpi-value" style="color:#2E7D32">${k.pct_recuperacao}%</div>
      </div>
      <div class="parc-kpi-card" style="border-top-color:#E60000">
        <div class="parc-kpi-icon" style="color:#E60000">⚠️</div>
        <div class="parc-kpi-label">PEND. COM TOA</div>
        <div class="parc-kpi-value" style="color:#E60000">${fmt(k.pend_toa)}</div>
      </div>
    `.replace(/</g, "<").replace(/>/g, ">");
  }

  function renderFigs(figs) {
    ["g1","g2","g3","g4","g5","g6"].forEach(k => {
      const el = document.getElementById("parc-" + k);
      if (!el) return;
      if (figs[k]) {
        Plotly.react(el, figs[k].data, figs[k].layout,
                     { responsive: true, displayModeBar: false });
      } else {
        Plotly.purge(el);
        el.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#999">Sem dados</div>`
          .replace(/</g, "<").replace(/>/g, ">");
      }
    });
  }

  function showLoading(v) {
    document.getElementById("parc-loading").style.display = v ? "flex" : "none";
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
{% endblock %}
