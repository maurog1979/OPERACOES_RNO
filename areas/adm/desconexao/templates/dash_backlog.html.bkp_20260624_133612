{% extends "base.html" %}
{% block content %}

<!-- Bootstrap 5 + Choices.js -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/styles/choices.min.css">

<style>
  .bkl-wrap { padding: 1rem 1.5rem 2rem; background:#F5F6FA; min-height:100vh; }
  .bkl-title-bar {
    display:flex; justify-content:space-between; align-items:center;
    background:linear-gradient(90deg,#E60000,#B71C1C); color:#fff;
    padding:.8rem 1.2rem; border-radius:.6rem; margin-bottom:1rem;
    font-weight:600;
  }
  .bkl-title-bar a { color:#fff; background:rgba(255,255,255,.15);
    padding:.4rem .8rem; border-radius:.4rem; text-decoration:none; font-size:.9rem; }
  .bkl-title-bar a:hover { background:rgba(255,255,255,.3); }
  .filter-bar { background:#fff; padding:1rem; border-radius:.6rem;
                box-shadow:0 1px 3px rgba(0,0,0,.06); margin-bottom:1rem; }
  .filter-bar label { font-size:.75rem; font-weight:600; color:#555;
                      text-transform:uppercase; margin-bottom:.3rem; display:block; }

  /* ===== Choices.js — estilo Claro (tags vermelhas) ===== */
  .choices { margin-bottom: 0 !important; font-size: .85rem; }
  .choices__inner {
    min-height: 38px !important;
    padding: 4px 7.5px 0 7.5px !important;
    background:#fff !important;
    border:1px solid #ced4da !important;
    border-radius:.375rem !important;
    font-size:.85rem !important;
  }
  .choices[data-type*="select-multiple"] .choices__button {
    border-left:1px solid rgba(255,255,255,.5) !important;
    margin: 0 -4px 0 8px !important;
  }
  .choices__list--multiple .choices__item {
    background-color:#E60000 !important;
    border:1px solid #B71C1C !important;
    color:#fff !important;
    font-weight:500 !important;
    border-radius:.3rem !important;
    padding:3px 10px !important;
    margin:2px 4px 2px 0 !important;
  }
  .choices__list--dropdown .choices__item--selectable.is-highlighted {
    background-color:#FCE4EC !important;
    color:#B71C1C !important;
  }
  .is-focused .choices__inner, .is-open .choices__inner {
    border-color:#E60000 !important;
    box-shadow:0 0 0 .15rem rgba(230,0,0,.15) !important;
  }
  .choices__placeholder { opacity:.6 !important; color:#999 !important; }

  .kpi-card { border:none; border-left:4px solid #1565C0; transition:transform .15s; }
  .kpi-card:hover { transform:translateY(-2px); }
  .section-header { background:#1A237E; color:#fff; padding:.5rem 1rem;
                    border-radius:.4rem; font-weight:600; font-size:.85rem;
                    letter-spacing:.05em; margin:1rem 0 .5rem; }
  .graph-card { background:#fff; border-radius:.6rem; padding:.5rem;
                box-shadow:0 1px 3px rgba(0,0,0,.06); }
  #btn-limpar { font-size:.8rem; }
</style>

<div class="bkl-wrap">

  <div class="bkl-title-bar">
    <div><i class="bi bi-layers-fill"></i> DESCONEXAO RNO --- BACKLOG</div>
    <a href="/area/adm/desconexao"><i class="bi bi-arrow-left"></i> Voltar ao Hub</a>
  </div>

  <div class="filter-bar">
    <div class="row g-2 mb-2">
      <div class="col-md-2 col-6"><label>ANO</label>
        <select id="f-ano" multiple data-ph="Todos"></select></div>
      <div class="col-md-2 col-6"><label>MES</label>
        <select id="f-mes" multiple data-ph="Todos"></select></div>
      <div class="col-md-2 col-6"><label>DIA</label>
        <select id="f-dia" multiple data-ph="Todos"></select></div>
      <div class="col-md-2 col-6"><label>UF</label>
        <select id="f-uf" multiple data-ph="Todas"></select></div>
      <div class="col-md-2 col-6"><label>CIDADE</label>
        <select id="f-cidade" multiple data-ph="Todas"></select></div>
      <div class="col-md-2 col-6"><label>PARCEIRA</label>
        <select id="f-parceira" multiple data-ph="Todas"></select></div>
    </div>
    <div class="row g-2">
      <div class="col-md-4 col-12"><label>SAFRA</label>
        <select id="f-safra" multiple data-ph="Todas"></select></div>
      <div class="col-md-4 col-12"><label>TIPO DESCONEXAO</label>
        <select id="f-tipo" multiple data-ph="Todos"></select></div>
      <div class="col-md-4 col-12"><label>PENDENCIA</label>
        <select id="f-pend" multiple data-ph="Todas"></select></div>
    </div>
    <div class="text-end mt-2">
      <button id="btn-limpar" class="btn btn-outline-danger btn-sm">
        <i class="bi bi-eraser"></i> Limpar filtros
      </button>
      <span id="status" class="ms-2 small text-muted"></span>
    </div>
  </div>

  <div id="kpis" class="row g-2 mb-3"></div>

  <div class="section-header">SITUACAO DE AGENDA E BACKLOG</div>
  <div class="row g-2">
    <div class="col-lg-6 col-12"><div class="graph-card"><div id="g1"></div></div></div>
    <div class="col-lg-6 col-12"><div class="graph-card"><div id="g2"></div></div></div>
  </div>

  <div class="section-header">AGING E MOTIVOS</div>
  <div class="row g-2">
    <div class="col-lg-6 col-12"><div class="graph-card"><div id="g3"></div></div></div>
    <div class="col-lg-6 col-12"><div class="graph-card"><div id="g4"></div></div></div>
  </div>

  <div class="section-header">ANALISE POR TIPO E TECNOLOGIA</div>
  <div class="row g-2">
    <div class="col-lg-6 col-12"><div class="graph-card"><div id="g5"></div></div></div>
    <div class="col-lg-6 col-12"><div class="graph-card"><div id="g6"></div></div></div>
  </div>

</div>

<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/scripts/choices.min.js"></script>
<script>
(function(){
  const FIELDS = ["ANO","MES","DIA","UF","NM_CIDADE","PARCEIRA_NOME",
                  "SAFRA","DS_TIPO_DESCONEXAO","PENDENCIA"];
  const MAP = {ANO:"f-ano",MES:"f-mes",DIA:"f-dia",UF:"f-uf",
               NM_CIDADE:"f-cidade",PARCEIRA_NOME:"f-parceira",
               SAFRA:"f-safra",DS_TIPO_DESCONEXAO:"f-tipo",PENDENCIA:"f-pend"};
  const KPIS = [
    {key:"no_backlog",   label:"NO BACKLOG",     icon:"bi-layers-fill",         cor:"#1565C0"},
    {key:"executadas",   label:"EXECUTADAS",     icon:"bi-check-circle-fill",   cor:"#2E7D32"},
    {key:"com_quebra",   label:"COM QUEBRA",     icon:"bi-exclamation-octagon-fill", cor:"#E60000"},
    {key:"sem_analitico",label:"SEM ANALITICO",  icon:"bi-question-circle-fill",cor:"#F9A825"},
  ];

  const choicesInstances = {};
  let _updating = false;   // flag para suprimir eventos durante updates programaticos
  let ctrl = null;
  let debounceTimer = null;
  const status = document.getElementById("status");
  const fmt = n => (n||0).toLocaleString("pt-BR");

  function debounce(fn, ms){
    return function(){
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(fn, ms);
    };
  }
  const refreshDebounced = debounce(refresh, 250);

  // ===== Inicializar Choices.js =====
  FIELDS.forEach(f => {
    const el = document.getElementById(MAP[f]);
    const ph = el.getAttribute("data-ph") || "Selecione...";
    const c = new Choices(el, {
      removeItemButton: true,
      shouldSort: false,
      placeholder: true,
      placeholderValue: ph,
      searchPlaceholderValue: "Buscar...",
      searchEnabled: true,
      itemSelectText: "",
      noResultsText: "Sem resultados",
      noChoicesText: "Sem opcoes",
      duplicateItemsAllowed: false,
    });
    choicesInstances[f] = c;
    // Listener — usa eventos do Choices.js (addItem/removeItem), nao 'change' do select
    el.addEventListener("addItem", () => { if (!_updating) refreshDebounced(); });
    el.addEventListener("removeItem", () => { if (!_updating) refreshDebounced(); });
  });

  // ===== Pega valores REALMENTE selecionados via API do Choices.js =====
  function getSelected(field){
    const c = choicesInstances[field];
    if (!c) return [];
    const v = c.getValue(true); // true => apenas values, sem labels
    return Array.isArray(v) ? v.map(String) : (v ? [String(v)] : []);
  }

  // ===== Atualiza dropdown SEM duplicar selecoes =====
  function setOpts(field, vals){
    const c = choicesInstances[field];
    if (!c) return;
    const selecionados = new Set(getSelected(field));
    _updating = true;
    try {
      // Monta lista de choices SEM marcar como selected (preserva selecoes atuais)
      const choices = (vals||[]).map(v => ({
        value: String(v),
        label: String(v),
        selected: false,
        disabled: false,
      }));
      // replaceChoices=true substitui apenas as opcoes do dropdown,
      // NAO mexe nas tags ja selecionadas no input
      c.setChoices(choices, "value", "label", true);
    } finally {
      _updating = false;
    }
  }

  function renderKpis(k){
    const box = document.getElementById("kpis");
    box.innerHTML = "";
    KPIS.forEach(d => {
      const v = (k && k[d.key]) || 0;
      const col = document.createElement("div");
      col.className = "col-md-3 col-6";
      col.innerHTML = `<div class="card shadow-sm text-center kpi-card" style="border-left-color:${d.cor}">
        <div class="card-body">
          <div class="mb-1"><i class="bi ${d.icon}" style="font-size:1.8rem;color:${d.cor}"></i></div>
          <p class="text-muted small mb-1">${d.label}</p>
          <h4 class="fw-bold" style="color:${d.cor}">${fmt(v)}</h4>
        </div>
      </div>`;
      box.appendChild(col);
    });
  }
  function drawFig(id, fig){
    const el = document.getElementById(id);
    if (!fig || !fig.data) {
      Plotly.purge(el);
      el.innerHTML = '<div class="text-muted text-center p-4">Sem dados</div>';
      return;
    }
    Plotly.react(el, fig.data, fig.layout, {responsive:true, displaylogo:false});
  }

  async function refresh(){
    if (ctrl) ctrl.abort();
    ctrl = new AbortController();
    status.textContent = "Atualizando...";
    const p = new URLSearchParams();
    FIELDS.forEach(f => {
      const vals = getSelected(f);
      if (vals.length) p.set(f, vals.join("||"));
    });
    try {
      const r = await fetch("/dash/backlog/api/refresh?" + p.toString(), {signal: ctrl.signal});
      const j = await r.json();
      if (j.error) { status.textContent = "Erro: " + j.error; return; }
      // Atualiza dropdowns (cascata)
      Object.keys(j.options || {}).forEach(k => {
        if (MAP[k]) setOpts(k, j.options[k]);
      });
      renderKpis(j.kpis);
      const figs = j.figs || {};
      ["g1","g2","g3","g4","g5","g6"].forEach(id => drawFig(id, figs[id]));
      status.textContent = j.empty ? "Sem resultados" : ("Total: " + fmt(j.total||0));
    } catch(e) {
      if (e.name !== "AbortError") {
        status.textContent = "Erro: " + e.message;
        console.error(e);
      }
    }
  }

  document.getElementById("btn-limpar").addEventListener("click", () => {
    _updating = true;
    FIELDS.forEach(f => {
      const c = choicesInstances[f];
      if (c) c.removeActiveItems();
    });
    _updating = false;
    refresh();
  });

  refresh();
})();
</script>

{% endblock %}
