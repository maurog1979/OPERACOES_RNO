{% extends "base.html" %}
{% block title %}LOG & Reincidência | Operações RNO{% endblock %}

{% block content %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css">
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>

<style>
  .dash-hero {
    background: linear-gradient(135deg, #E60000 0%, #B71C1C 100%);
    color: white; padding: 1.4rem 2rem;
    border-radius: 0 0 18px 18px;
    box-shadow: 0 6px 24px rgba(230,0,0,0.25);
    display: flex; justify-content: space-between; align-items: center;
    margin: 0 1.5rem 1rem;
  }
  .dash-hero h1 {
    margin: 0; font-size: 1.35rem; font-weight: 700; color: white;
    font-family: 'Inter','Segoe UI',sans-serif; letter-spacing: 0.5px;
  }
  .dash-hero h1 i { margin-right: 0.6rem; }
  .dash-hero .btn-voltar {
    background: rgba(255,255,255,0.18); color: white !important;
    padding: 0.55rem 1.1rem; border-radius: 10px;
    text-decoration: none; backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.25); font-weight: 600;
    display: inline-flex; align-items: center; gap: 0.4rem;
    transition: all 0.2s ease;
  }
  .dash-hero .btn-voltar:hover { background: rgba(255,255,255,0.32); transform: translateY(-1px); }

  .log-filter-bar {
    background: white; padding: 1rem 1.5rem;
    margin: 0 1.5rem 1rem; border-radius: 14px;
    box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
    position: relative; z-index: 100;
  }
  .log-filter-bar label {
    display: block; font-size: 0.72rem; font-weight: 700;
    color: #555; margin-bottom: 0.3rem;
    text-transform: uppercase; letter-spacing: 0.5px;
  }

  .log-kpi-row {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.85rem;
    margin: 0 1.5rem 1rem;
  }
  .log-kpi-card {
    background: white; padding: 1.1rem 1rem; border-radius: 14px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.05);
    text-align: center; border-left: 5px solid #E60000;
    transition: transform 0.15s ease;
  }
  .log-kpi-card:hover { transform: translateY(-2px); }
  .log-kpi-card .icon { font-size: 1.6rem; margin-bottom: 0.4rem; }
  .log-kpi-card .label {
    font-size: 0.7rem; color: #777; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.5px;
  }
  .log-kpi-card .value {
    font-size: 1.7rem; font-weight: 800; margin-top: 0.2rem;
  }

  .log-section-header {
    margin: 1.4rem 1.5rem 0.6rem; font-size: 0.85rem; font-weight: 800;
    color: #444; text-transform: uppercase; padding-left: 0.8rem;
    border-left: 5px solid #E60000; letter-spacing: 0.6px;
  }

  .log-chart-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
    margin: 0 1.5rem 1rem;
  }
  .log-chart-card {
    background: white; padding: 0.9rem; border-radius: 14px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.05);
  }

  .choices { font-size: 0.85rem; margin-bottom: 0 !important; }
  .choices__list--dropdown { z-index: 9999 !important; }

  #log-loading-overlay {
    position: fixed; inset: 0; background: rgba(255,255,255,0.85);
    display: none; align-items: center; justify-content: center;
    z-index: 99999; backdrop-filter: blur(4px);
  }
  #log-loading-overlay.show { display: flex; }
  .log-spinner {
    width: 56px; height: 56px; border: 5px solid #f3f3f3;
    border-top: 5px solid #E60000; border-radius: 50%;
    animation: log-spin 0.8s linear infinite;
  }
  @keyframes log-spin { 100% { transform: rotate(360deg); } }

  @media (max-width: 1100px) {
    .log-filter-bar { grid-template-columns: 1fr 1fr; }
    .log-kpi-row    { grid-template-columns: 1fr 1fr 1fr; }
    .log-chart-row  { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .log-filter-bar, .log-kpi-row { grid-template-columns: 1fr; }
  }

  .log-chart-card {
    overflow: hidden;
    min-height: 390px;
  }
  #g1, #g2, #g3, #g4, #g5, #g6 {
    width: 100%;
    min-height: 350px;
  }
  .js-plotly-plot,
  .plot-container,
  .svg-container {
    max-width: 100% !important;
  }

</style>

<div class="dash-hero">
  <h1><i class="fas fa-rotate"></i> DESCONEXÃO RNO — LOG &amp; REINCIDÊNCIA</h1>
  <a href="/area/adm/desconexao/" class="btn-voltar"><i class="fas fa-arrow-left"></i> Voltar</a>
</div>

<div class="log-filter-bar">
  <div><label>SAFRA</label><select id="f-SAFRA" multiple></select></div>
  <div><label>TIPO DESCONEXÃO</label><select id="f-DS_TIPO_DESCONEXAO" multiple></select></div>
  <div><label>CIDADE</label><select id="f-NM_CIDADE" multiple></select></div>
  <div><label>PENDÊNCIA</label><select id="f-PENDENCIA" multiple></select></div>
</div>

<div class="log-kpi-row">
  <div class="log-kpi-card" style="border-left-color:#9E9E9E">
    <div class="icon" style="color:#9E9E9E"><i class="fas fa-database"></i></div>
    <div class="label">TOTAL</div>
    <div class="value" id="kpi-total" style="color:#333">0</div>
  </div>
  <div class="log-kpi-card" style="border-left-color:#F57C00">
    <div class="icon" style="color:#F57C00"><i class="fas fa-triangle-exclamation"></i></div>
    <div class="label">COM LOG</div>
    <div class="value" id="kpi-com-log" style="color:#F57C00">0</div>
  </div>
  <div class="log-kpi-card" style="border-left-color:#2E7D32">
    <div class="icon" style="color:#2E7D32"><i class="fas fa-circle-check"></i></div>
    <div class="label">SEM LOG</div>
    <div class="value" id="kpi-sem-log" style="color:#2E7D32">0</div>
  </div>
  <div class="log-kpi-card" style="border-left-color:#E60000">
    <div class="icon" style="color:#E60000"><i class="fas fa-fire"></i></div>
    <div class="label">CRÍTICOS (6+)</div>
    <div class="value" id="kpi-criticos" style="color:#E60000">0</div>
  </div>
  <div class="log-kpi-card" style="border-left-color:#1565C0">
    <div class="icon" style="color:#1565C0"><i class="fas fa-percent"></i></div>
    <div class="label">% COM LOG</div>
    <div class="value" id="kpi-pct-log" style="color:#1565C0">0%</div>
  </div>
</div>

<div class="log-section-header">DISTRIBUIÇÃO DO LOG</div>
<div class="log-chart-row">
  <div class="log-chart-card"><div id="g1"></div></div>
  <div class="log-chart-card"><div id="g2"></div></div>
</div>

<div class="log-section-header">MOTIVOS E RESPONSÁVEIS</div>
<div class="log-chart-row">
  <div class="log-chart-card"><div id="g3"></div></div>
  <div class="log-chart-card"><div id="g4"></div></div>
</div>

<div class="log-section-header">ANÁLISE POR TIPO E CIDADE</div>
<div class="log-chart-row">
  <div class="log-chart-card"><div id="g5"></div></div>
  <div class="log-chart-card"><div id="g6"></div></div>
</div>

<div id="log-loading-overlay"><div class="log-spinner"></div></div>

<script>
(function(){
  const FILTERS = ["SAFRA", "DS_TIPO_DESCONEXAO", "NM_CIDADE", "PENDENCIA"];
  const choicesObj = {};
  let debounceTimer = null;
  let firstLoad = true;

  function showLoading(s){
    document.getElementById("log-loading-overlay").classList.toggle("show", s);
  }
  function fmtNum(n){return new Intl.NumberFormat("pt-BR").format(n);}
  function getSelected(){
    const sel = {};
    FILTERS.forEach(f => { sel[f] = choicesObj[f] ? choicesObj[f].getValue(true) : []; });
    return sel;
  }
  function buildQuery(sel){
    const p = new URLSearchParams();
    FILTERS.forEach(f => (sel[f]||[]).forEach(v => p.append(f, v)));
    return p.toString();
  }

  async function readJsonOrThrow(response, label){
    const contentType = response.headers.get("content-type") || "";
    const text = await response.text();

    if (!response.ok) {
      throw new Error("Endpoint " + label + " retornou HTTP " + response.status + ": " + text.slice(0, 180));
    }

    if (!contentType.includes("application/json")) {
      throw new Error("Endpoint " + label + " não retornou JSON. Início da resposta: " + text.slice(0, 180));
    }

    return JSON.parse(text);
  }

  async function refreshOptions(){
    const sel = getSelected();
    const r = await fetch("/dash/log/api/options?" + buildQuery(sel), {headers: {"Accept": "application/json"}});
    const opts = await readJsonOrThrow(r, "options");
    FILTERS.forEach(f => {
      const current = sel[f] || [];
      choicesObj[f].clearStore();
      const items = (opts[f]||[]).map(v => ({value:v, label:v, selected:current.includes(v)}));
      choicesObj[f].setChoices(items, "value", "label", true);
    });
  }

  async function refreshData(){
    showLoading(true);
    try {
      const sel = getSelected();
      const r = await fetch("/dash/log/api/data?" + buildQuery(sel), {headers: {"Accept": "application/json"}});
      const d = await readJsonOrThrow(r, "data");

      document.getElementById("kpi-total").textContent    = fmtNum(d.kpis.total);
      document.getElementById("kpi-com-log").textContent  = fmtNum(d.kpis.com_log);
      document.getElementById("kpi-sem-log").textContent  = fmtNum(d.kpis.sem_log);
      document.getElementById("kpi-criticos").textContent = fmtNum(d.kpis.criticos);
      document.getElementById("kpi-pct-log").textContent  = d.kpis.pct_log + "%";

      ["g1","g2","g3","g4","g5","g6"].forEach(id => {
        const el = document.getElementById(id);
        Plotly.purge(el);
        Plotly.react(el, d[id].data || [], d[id].layout || {}, {
          responsive: true,
          displayModeBar: false
        });
      });
    } catch (e) {
      console.error("[dash_log] erro:", e);
      alert("Erro: " + e.message);
    } finally {
      showLoading(false);
    }
  }

  function onFilterChange(){
    if (firstLoad) return;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
      await refreshOptions();
      await refreshData();
    }, 250);
  }

  function init(){
    if (typeof Choices === "undefined" || typeof Plotly === "undefined") {
      console.warn("[dash_log] CDN ainda nao carregou, tentando de novo...");
      setTimeout(init, 200);
      return;
    }
    FILTERS.forEach(f => {
      const el = document.getElementById("f-" + f);
      choicesObj[f] = new Choices(el, {
        removeItemButton: true,
        placeholderValue: "Todos...",
        searchEnabled: true,
        shouldSort: false,
        itemSelectText: "",
      });
      el.addEventListener("change", onFilterChange);
    });
    (async () => {
      await refreshOptions();
      await refreshData();
      firstLoad = false;
    })();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
{% endblock %}
